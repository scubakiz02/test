<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="ALTSConnectionString" connectionString="Server=localhost;Database=ALTS;Trusted_Connection=True" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<appSettings>
