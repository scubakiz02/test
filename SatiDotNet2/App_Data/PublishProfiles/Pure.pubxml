<?xml version="1.0" encoding="utf-8"?>
<!--
This file is used by the publish/package process of your Web project. You can customize the behavior of this process
by editing this MSBuild file. In order to learn more about this please visit http://go.microsoft.com/fwlink/?LinkID=208121. 
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<WebPublishMethod>FileSystem</WebPublishMethod>
		<LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
		<LastUsedPlatform>Any CPU</LastUsedPlatform>
		<SiteUrlToLaunchAfterPublish />
		<LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
		<ExcludeApp_Data>False</ExcludeApp_Data>
		
		<!--production publish path-->
		<publishUrl>\\PWI-40\WEBSites$\SATI.Net</publishUrl> 
		
		<!--testing publish path-->
		<!--<publishUrl>\\PWI-40\WEBSites$\SATI.Net-Test</publishUrl>-->
		
		<DeleteExistingFiles>True</DeleteExistingFiles>

		<!--to reduce publish times, exclude folders & files from publishing-->
		<ExcludeFilesFromDeployment>
			**\node_modules\**;
			**\packages\**;
			**\.vs\**;
			**\.vscode\**;
		</ExcludeFilesFromDeployment>
	</PropertyGroup>

	<!--
		Force Web.config transforms during FileSystem publish (which normally skips them).
		- Runs after MSBuild gathers files to publish (PipelineCollectFilesPhase)
		- Resolves the transform file (e.g. Web.Release.config) based on the active build configuration
		- Applies xdt:Transform directives from the transform file against the base Web.config,
		  writing the merged result to an intermediate folder (obj\...\transformed\Web.config)
		- Swaps the original untransformed Web.config out of the publish file list and
		  replaces it with the transformed version
		Without this, FileSystem publish would deploy the raw Web.config with dev defaults
		instead of the production values from Web.Release.config.
	-->
	<Target Name="ApplyWebConfigTransform" AfterTargets="PipelineCollectFilesPhase">
		<PropertyGroup>
			<_TransformFile>Web.$(LastUsedBuildConfiguration).config</_TransformFile>
			<_TransformOutput>$(IntermediateOutputPath)transformed\</_TransformOutput>
		</PropertyGroup>
		<MakeDir Directories="$(_TransformOutput)"/>
		<TransformXml Source="Web.config"
					  Transform="$(_TransformFile)"
					  Destination="$(_TransformOutput)Web.config"
					  Condition="Exists('$(_TransformFile)')"/>
		<ItemGroup>
			<FilesForPackagingFromProject Remove="Web.config"/>
			<FilesForPackagingFromProject Include="$(_TransformOutput)Web.config">
				<DestinationRelativePath>Web.config</DestinationRelativePath>
			</FilesForPackagingFromProject>
		</ItemGroup>
	</Target>

</Project>