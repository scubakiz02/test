    Function CheckSum(ByVal M12 As String) As String

        If Not M12.Length = 10 Then
            CheckSum = "T7 Is Not 10 Chr"
            Exit Function
        End If

        Dim C1Neg32 As Int16 = GetDEC(Mid(M12, 1, 1)) - 32
        Dim C2Neg32 As Int16 = GetDEC(Mid(M12, 2, 1)) - 32
        Dim C3Neg32 As Int16 = GetDEC(Mid(M12, 3, 1)) - 32
        Dim C4Neg32 As Int16 = GetDEC(Mid(M12, 4, 1)) - 32
        Dim C5Neg32 As Int16 = GetDEC(Mid(M12, 5, 1)) - 32
        Dim C6Neg32 As Int16 = GetDEC(Mid(M12, 6, 1)) - 32
        Dim C7Neg32 As Int16 = GetDEC(Mid(M12, 7, 1)) - 32
        Dim C8Neg32 As Int16 = GetDEC(Mid(M12, 8, 1)) - 32
        Dim C9Neg32 As Int16 = GetDEC(Mid(M12, 9, 1)) - 32
        Dim C10Neg32 As Int16 = GetDEC(Mid(M12, 10, 1)) - 32

        Dim C1By8MOD As Int16 = 8 * C1Neg32 Mod 59
        Dim C2By8MOD As Int16 = 8 * (C1By8MOD + C2Neg32) Mod 59
        Dim C3By8MOD As Int16 = 8 * (C2By8MOD + C3Neg32) Mod 59
        Dim C4By8MOD As Int16 = 8 * (C3By8MOD + C4Neg32) Mod 59
        Dim C5By8MOD As Int16 = 8 * (C4By8MOD + C5Neg32) Mod 59
        Dim C6By8MOD As Int16 = 8 * (C5By8MOD + C6Neg32) Mod 59
        Dim C7By8MOD As Int16 = 8 * (C6By8MOD + C7Neg32) Mod 59
        Dim C8By8MOD As Int16 = 8 * (C7By8MOD + C8Neg32) Mod 59
        Dim C9By8MOD As Int16 = 8 * (C8By8MOD + C9Neg32) Mod 59
        Dim C10By8MOD As Int16 = 8 * (C9By8MOD + C10Neg32) Mod 59

        Dim By8MOD33 As Int16 = 8 * (C10By8MOD + 33) Mod 59
        Dim MOD16 As Int16 = (By8MOD33 + 16) Mod 59
        Dim MOD59 As Int16 = (59 - MOD16) Mod 59

        Dim Mod59Binary As String = Convert.ToString(MOD59 + 64, 2)

        Dim Binary234 As String = Mid(Mod59Binary, 2, 3)
        Dim BinaryE3 As String = Right(Mod59Binary, 3)

        Dim CS1 As String = Chr(65 + GetDecStrForBits(Binary234))
        Dim CS2 As String = GetDecStrForBits(BinaryE3)

        CheckSum = CS1 & CS2

    End Function

