    Sub MaintenanceRequestCloseTest(ByVal Ticket As String)

        Dim DS As Data.DataSet
        Dim DR As Data.DataRow
        Dim Count As Integer
        Dim SB As New StringBuilder
        Dim I As Integer
        Dim Subject As String

        DS = GetMyDataSet("SELECT TOP (100) PERCENT dbo.T_MR_Tickets.MR_Key, dbo.T_Tools.Department, dbo.T_Tools.Tool, dbo.T_MR_Tickets.Status, dbo.T_MR_Tickets.IssueDate, dbo.T_MR_Tickets.IssueUser, dbo.T_MR_Tickets.CloseDate, dbo.T_MR_Tickets.CloseUser, dbo.T_MR_TicketNotes.NoteType, dbo.T_MR_TicketNotes.Note, dbo.T_MR_TicketNotes.NoteDate, dbo.T_MR_TicketNotes.SatiUser, dbo.T_MR_TicketNotes.[Key] FROM dbo.T_MR_Tickets INNER JOIN dbo.T_Tools ON dbo.T_MR_Tickets.Tool = dbo.T_Tools.[Key] LEFT OUTER JOIN dbo.T_MR_TicketNotes ON dbo.T_MR_Tickets.MR_Key = dbo.T_MR_TicketNotes.MR_Key GROUP BY dbo.T_MR_Tickets.MR_Key, dbo.T_Tools.Department, dbo.T_Tools.Tool, dbo.T_MR_Tickets.Status, dbo.T_MR_Tickets.IssueDate, dbo.T_MR_Tickets.IssueUser, dbo.T_MR_Tickets.CloseDate, dbo.T_MR_Tickets.CloseUser, dbo.T_MR_TicketNotes.NoteType, dbo.T_MR_TicketNotes.Note, dbo.T_MR_TicketNotes.NoteDate, dbo.T_MR_TicketNotes.SatiUser, dbo.T_MR_TicketNotes.[Key] HAVING (dbo.T_MR_Tickets.MR_Key = " & Ticket & ") ORDER BY dbo.T_MR_TicketNotes.[Key]")
        Count = DS.Tables(0).Rows.Count

        If Count > 1 Then
            SB.Append(<h1 style="color: #0000FF">Maintenance Request Closed</h1>)
            SB.Append(<br/>)
            For I = 0 To Count - 1
                DR = DS.Tables(0).Rows(I)

                If DR("NoteType") = "Org" Then
                    Subject = "Ticket " & DR("MR_Key").ToString & " for " & DR("Tool").ToString & " is Closed"
                    SB.Append("<font size=5>Ticket: </font> &nbsp; <font size=5 color=red><b>" & DR("MR_Key").ToString & "</b></font>")
                    SB.Append(<br/>)
                    SB.Append("<font size=5>Tool: </font> &nbsp; <font size=5 color=red><b>" & DR("Tool").ToString & "</b></font>")
                    SB.Append(<br/>)
                    SB.Append("<font size=5>Start Time: </font> &nbsp; <font size=5 color=red><b>" & DR("IssueDate").ToString & "</b></font>")
                    SB.Append(<br/>)
                    SB.Append("<font size=5>From User " & DR("SatiUser").ToString & ": </font> &nbsp; <font size=5 color=red><b>" & DR("Note").ToString & "</b></font>")
                    SB.Append(<br/>)
                    SB.Append(<br/>)
                End If
            Next
            For I = 0 To Count - 1
                DR = DS.Tables(0).Rows(I)
                If DR("NoteType") = "Tech" Then
                    SB.Append("<font size=5>Tech User: " & DR("SatiUser").ToString & " : </font> &nbsp; <font size=5 color=red><b>" & DR("Note").ToString & "</b></font>")
                    SB.Append(<br/>)
                    SB.Append(<br/>)
                End If
            Next
            SB.Append("<font size=5>Close Time: </font> &nbsp; <font size=5 color=red><b>" & DR("CloseDate").ToString & "</b></font>")
            SB.Append(<br/>)

        End If

        SendMail_HTML(SB.ToString, Subject, "AZ.SatiMaintenanceRequest@purewafer.com", "")

    End Sub
