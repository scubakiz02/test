    Function IS_RFID_Enable(ByVal TheID As String) As Boolean

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()
        Dim DA_ID As New Data.SqlClient.SqlDataAdapter
        Dim DS_ID As New Data.DataSet
        Dim DR_ID As Data.DataRow
        Dim IDSelectCmd As New System.Data.SqlClient.SqlCommand
        With IDSelectCmd
            .CommandText = "SELECT MainID, RFID_Enable FROM dbo.MainID WHERE (MainID = N'" & TheID & "')"
            .Connection = Connection
        End With
        DA_ID.SelectCommand = IDSelectCmd
        DA_ID.Fill(DS_ID)
        DR_ID = DS_ID.Tables(0).Rows(0)
        IS_RFID_Enable = DR_ID("RFID_Enable")
        Connection.Close()



    End Function

    Function Check_RFID_Used_Last20Days(ByVal RFID As String, ByVal MyDate As DateTime) As Boolean
        Dim DS As Data.DataSet
        Dim SQL As String
        Dim Date20DaysLess As DateTime

        Date20DaysLess = DateAndTime.DateAdd(DateInterval.Day, -20, MyDate)

        'SELECT CreationDate, RFID FROM dbo.SP1_Data WHERE (CreationDate < CONVERT(DATETIME, '2013-05-24 02:57:31', 102) AND CreationDate > CONVERT(DATETIME, '2013-05-04 02:57:31', 102)) AND (RFID = N'00153745')
        SQL = "SELECT CreationDate, RFID FROM dbo.SP1_Data WHERE (CreationDate < CONVERT(DATETIME, '" & MyDate & "', 102) AND CreationDate > CONVERT(DATETIME, '" & Date20DaysLess & "', 102)) AND (RFID = N'" & RFID & "')"
        DS = GetMyDataSetAutoData(SQL)

        If DS.Tables(0).Rows.Count < 25 Then
            Return False
        Else
            Return True
        End If



    End Function

    Function IsLotNumberReal(ByVal LotNumber As String) As Boolean
        Dim DS_LotReal As Data.DataSet = GetMyDataSet("SELECT LotEntry FROM dbo.WaferMover GROUP BY LotEntry HAVING (LotEntry = N'" & LotNumber & "')")
        If DS_LotReal.Tables(0).Rows.Count = 0 Then
            Return False
        Else
            Return True
        End If
    End Function

