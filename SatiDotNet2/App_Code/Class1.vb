    Function KPI_Data(ByVal Stage As String, ByVal Type_1_R_B As String, ByVal StartDate As String, ByVal EndDate As String, ByVal Size300mm As Boolean, ByVal SP2 As Boolean) As String
        KPI_Data = ""
        'Main Set
        'SELECT TOP 100 PERCENT dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4) AS LotID, SUM(dbo.WaferMover.OutQty) AS [Qty Out], SUM(ISNULL(dbo.DefectTracking.Qty, 0)) AS Rejects FROM dbo.UniqueProcesses INNER JOIN dbo.WaferMover ON dbo.UniqueProcesses.LotEntry = dbo.WaferMover.LotEntry AND dbo.UniqueProcesses.ProcessOrder = dbo.WaferMover.[Order] LEFT OUTER JOIN dbo.DefectTracking ON dbo.WaferMover.MovementEntry = dbo.DefectTracking.MovementEntry WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '2013-03-01 00:00:00', 102) AND dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '2013-03-31 12:59:59', 102)) GROUP BY dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4) HAVING (dbo.UniqueProcesses.StageName = N'CMP') ORDER BY LEFT(dbo.WaferMover.LotEntry, 4)

        'Reject Data
        'SELECT TOP 100 PERCENT dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4) AS LotID, dbo.DefectTracking.DefectName, SUM(dbo.DefectTracking.Qty) AS RejectCount FROM dbo.UniqueProcesses INNER JOIN dbo.WaferMover ON dbo.UniqueProcesses.LotEntry = dbo.WaferMover.LotEntry AND dbo.UniqueProcesses.ProcessOrder = dbo.WaferMover.[Order] INNER JOIN dbo.DefectTracking ON dbo.WaferMover.MovementEntry = dbo.DefectTracking.MovementEntry WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '2013-03-01 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '2013-03-31 12:59:59', 102)) GROUP BY dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4), dbo.DefectTracking.DefectName HAVING (dbo.UniqueProcesses.StageName = N'CMP') ORDER BY LEFT(dbo.WaferMover.LotEntry, 4), dbo.DefectTracking.DefectName

        'Reject Names
        'SELECT TOP 100 PERCENT dbo.DefectTracking.DefectName FROM dbo.UniqueProcesses INNER JOIN dbo.WaferMover ON dbo.UniqueProcesses.LotEntry = dbo.WaferMover.LotEntry AND dbo.UniqueProcesses.ProcessOrder = dbo.WaferMover.[Order] INNER JOIN dbo.DefectTracking ON dbo.WaferMover.MovementEntry = dbo.DefectTracking.MovementEntry WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '2013-03-01 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '2013-03-31 12:59:59', 102)) AND (dbo.UniqueProcesses.StageName = N'CMP') GROUP BY dbo.DefectTracking.DefectName ORDER BY dbo.DefectTracking.DefectName

        'Where Type add
        '1
        ' AND (NOT (dbo.WaferMover.LotEntry LIKE N'%r%'))
        'R
        ' AND (dbo.WaferMover.LotEntry LIKE N'%r%')

        '300mm
        'AND (dbo.WaferMover.LotEntry LIKE N'3%')


        'SP1 DB Station Count
        'SELECT TOP 100 PERCENT ID#, SUM(CASE WHEN DestinationStationID = 1 THEN 1 ELSE 0 END) AS Bin1, SUM(CASE WHEN DestinationStationID = 2 THEN 1 ELSE 0 END) AS Bin2, SUM(CASE WHEN DestinationStationID = 3 THEN 1 ELSE 0 END) AS Bin3, COUNT(DestinationStationID) AS Total FROM dbo.SP1_Data WHERE (CreationDate > CONVERT(DATETIME, '2013-03-01 00:00:00', 102)) AND (CreationDate < CONVERT(DATETIME, '2013-03-30 00:00:00', 102)) GROUP BY ID# ORDER BY ID#



        'Build SQL

        Dim MainDS As Data.DataSet
        Dim RejectDS As Data.DataSet
        Dim RejectNamesDS As Data.DataSet
        Dim SurfDS As Data.DataSet
        Dim P_InfoDS As Data.DataSet

        Dim MainSQL As String
        Dim RejectSQL As String
        Dim RejectNameSQL As String
        Dim SurfSQL As String
        Dim P_InfoSQL As String

        Dim MainDR As Data.DataRow
        Dim RejectDR As Data.DataRow
        Dim RejectNameDR As Data.DataRow
        Dim SurfDR As Data.DataRow
        Dim P_InfoDR As Data.DataRow

        MainSQL = ""
        'Select and From
        MainSQL = "SELECT TOP 100 PERCENT dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4) AS LotID, SUM(dbo.WaferMover.OutQty) AS [Qty Out], SUM(ISNULL(dbo.DefectTracking.Qty, 0)) AS Rejects FROM dbo.UniqueProcesses INNER JOIN dbo.WaferMover ON dbo.UniqueProcesses.LotEntry = dbo.WaferMover.LotEntry AND dbo.UniqueProcesses.ProcessOrder = dbo.WaferMover.[Order] LEFT OUTER JOIN dbo.DefectTracking ON dbo.WaferMover.MovementEntry = dbo.DefectTracking.MovementEntry "
        'Where
        Select Case Type_1_R_B
            Case "1"
                MainSQL = MainSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102) AND dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (NOT (dbo.WaferMover.LotEntry LIKE N'%r%')) "
            Case "R"
                MainSQL = MainSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102) AND dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (dbo.WaferMover.LotEntry LIKE N'%r%') "
            Case Else
                MainSQL = MainSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102) AND dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) "
        End Select
        If Size300mm = True Then
            MainSQL = MainSQL & "AND (dbo.WaferMover.LotEntry LIKE N'3%') "
        End If
        'Group,Having,Order
        MainSQL = MainSQL & "GROUP BY dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4) HAVING (dbo.UniqueProcesses.StageName = N'" & Stage & "') ORDER BY LEFT(dbo.WaferMover.LotEntry, 4)"

        MainDS = GetMyDataSet(MainSQL)


        RejectSQL = ""
        'Select and From
        RejectSQL = "SELECT TOP 100 PERCENT dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4) AS LotID, dbo.DefectTracking.DefectName, SUM(dbo.DefectTracking.Qty) AS RejectCount FROM dbo.UniqueProcesses INNER JOIN dbo.WaferMover ON dbo.UniqueProcesses.LotEntry = dbo.WaferMover.LotEntry AND dbo.UniqueProcesses.ProcessOrder = dbo.WaferMover.[Order] INNER JOIN dbo.DefectTracking ON dbo.WaferMover.MovementEntry = dbo.DefectTracking.MovementEntry "
        'Where
        Select Case Type_1_R_B
            Case "1"
                RejectSQL = RejectSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (NOT (dbo.WaferMover.LotEntry LIKE N'%r%')) "
            Case "R"
                RejectSQL = RejectSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (dbo.WaferMover.LotEntry LIKE N'%r%') "
            Case Else
                RejectSQL = RejectSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) "
        End Select
        If Size300mm = True Then
            RejectSQL = RejectSQL & "AND (dbo.WaferMover.LotEntry LIKE N'3%') "
        End If
        'Group,Having,Order
        RejectSQL = RejectSQL & "GROUP BY dbo.UniqueProcesses.StageName, LEFT(dbo.WaferMover.LotEntry, 4), dbo.DefectTracking.DefectName HAVING (dbo.UniqueProcesses.StageName = N'" & Stage & "') ORDER BY LEFT(dbo.WaferMover.LotEntry, 4), dbo.DefectTracking.DefectName"

        RejectDS = GetMyDataSet(RejectSQL)


        RejectNameSQL = ""
        'Select and From
        RejectNameSQL = "SELECT TOP 100 PERCENT dbo.DefectTracking.DefectName FROM dbo.UniqueProcesses INNER JOIN dbo.WaferMover ON dbo.UniqueProcesses.LotEntry = dbo.WaferMover.LotEntry AND dbo.UniqueProcesses.ProcessOrder = dbo.WaferMover.[Order] INNER JOIN dbo.DefectTracking ON dbo.WaferMover.MovementEntry = dbo.DefectTracking.MovementEntry "
        'Where
        Select Case Type_1_R_B
            Case "1"
                RejectNameSQL = RejectNameSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (dbo.UniqueProcesses.StageName = N'" & Stage & "') AND (NOT (dbo.WaferMover.LotEntry LIKE N'%r%')) "
            Case "R"
                RejectNameSQL = RejectNameSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (dbo.UniqueProcesses.StageName = N'" & Stage & "') AND (dbo.WaferMover.LotEntry LIKE N'%r%') "
            Case Else
                RejectNameSQL = RejectNameSQL & "WHERE (dbo.UniqueProcesses.Complete > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (dbo.UniqueProcesses.Complete < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (dbo.UniqueProcesses.StageName = N'" & Stage & "') "
        End Select
        If Size300mm = True Then
            RejectNameSQL = RejectNameSQL & "AND (dbo.WaferMover.LotEntry LIKE N'3%') "
        End If
        'Group,Having,Order
        RejectNameSQL = RejectNameSQL & "GROUP BY dbo.DefectTracking.DefectName ORDER BY dbo.DefectTracking.DefectName"

        RejectNamesDS = GetMyDataSet(RejectNameSQL)

        If Stage = "Laser Inspection" Then
            'Select and From
            SurfSQL = "SELECT TOP 100 PERCENT ID#, SUM(CASE WHEN DestinationStationID = 1 THEN 1 ELSE 0 END) AS Bin1, SUM(CASE WHEN DestinationStationID = 2 THEN 1 ELSE 0 END) AS Bin2, SUM(CASE WHEN DestinationStationID = 3 THEN 1 ELSE 0 END) AS Bin3, COUNT(DestinationStationID) AS Total FROM dbo.SP1_Data "
            'Where
            Select Case Type_1_R_B 'AND (Wafer_log LIKE N'r%')
                Case "1"
                    SurfSQL = SurfSQL & "WHERE (CreationDate > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (CreationDate < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (NOT (Wafer_log LIKE N'r%')) "
                Case "R"
                    SurfSQL = SurfSQL & "WHERE (CreationDate > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (CreationDate < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) AND (Wafer_log LIKE N'r%') "
                Case Else
                    SurfSQL = SurfSQL & "WHERE (CreationDate > CONVERT(DATETIME, '" & StartDate & " 00:00:00', 102)) AND (CreationDate < CONVERT(DATETIME, '" & EndDate & " 12:59:59', 102)) "
            End Select
            If SP2 = True Then
                SurfSQL = SurfSQL & "AND (Machine = N'SP2-S0132') "
            End If

            'Group,Having,Order
            SurfSQL = SurfSQL & "GROUP BY ID# ORDER BY ID#"

            SurfDS = GetMyDataSetAutoData(SurfSQL)

        End If

        Dim Flex As New FlexCel.XlsAdapter.XlsFile(True)

        Dim Path As String
        Path = "\\PWI-40\software$\LabelTemplates\KPI_PWI_Template.xls"
        Flex.Open(Path)

        'Get Formats
        Flex.ActiveSheetByName = "Formats"
        Dim F_Border As Integer
        Dim F_Precent As Integer
        F_Border = Flex.GetCellFormat(2, 2)
        F_Precent = Flex.GetCellFormat(6, 2)


        Flex.ActiveSheetByName = "Data"

        Dim ID_Count As Integer = MainDS.Tables(0).Rows.Count - 1
        Dim Defect_Count As Integer = RejectNamesDS.Tables(0).Rows.Count - 1
        Dim TotalQty As Integer = 0
        Dim TotalRejects As Integer = 0

        Dim SizeText As String = "All"
        If Size300mm = True Then
            SizeText = "300mm"
        End If

        Dim ProcessType As String = ""
        Select Case Type_1_R_B
            Case "1"
                ProcessType = "1st Pass"
            Case "R"
                ProcessType = "Rework"
            Case Else
                ProcessType = "1st Pass and Rework"
        End Select

        Flex.SetCellValue(1, 1, "Stage: " & Stage)
        Flex.SetCellValue(2, 1, "Wafer Process: " & ProcessType)
        Flex.SetCellValue(3, 1, "Wafer Size: " & SizeText)
        Flex.SetCellValue(1, 7, "Report Date Range: " & StartDate & " - " & EndDate)

        Dim StartRowHeader As Int16 = 5
        Dim StartRowdata As Int16 = 6

        'Headers
        Flex.SetCellValue(StartRowHeader, 1, "ID")
        Flex.SetCellValue(StartRowHeader, 2, "Qty")
        Flex.SetCellValue(StartRowHeader, 3, "Rejects")
        Flex.SetCellValue(StartRowHeader, 4, "Passed")
        Flex.SetCellValue(StartRowHeader, 5, "%")

        Dim Range As New FlexCel.Core.TXlsCellRange
        Range.Right = 110
        Range.Top = 1
        Range.Bottom = 1
        Range.Left = 1




        For m As Int16 = 0 To MainDS.Tables(0).Rows.Count - 1

            Flex.InsertAndCopyRange(Range, StartRowdata + m, 1, 1, Core.TFlxInsertMode.ShiftRowDown, Core.TRangeCopyMode.None, Flex, Flex.ActiveSheet)
            MainDR = MainDS.Tables(0).Rows(m)
            Flex.SetCellValue(StartRowdata + m, 1, MainDR("LotID"))
            Flex.SetCellValue(StartRowdata + m, 2, MainDR("Qty Out"))
            TotalQty = TotalQty + MainDR("Qty Out")
            Flex.SetCellValue(StartRowdata + m, 3, MainDR("Rejects"))
            TotalRejects = TotalRejects + MainDR("Rejects")
            Flex.SetCellValue(StartRowdata + m, 4, MainDR("Qty Out") - MainDR("Rejects"))
            Flex.SetCellValue(StartRowdata + m, 5, (MainDR("Qty Out") - MainDR("Rejects")) / MainDR("Qty Out"))

            For r As Integer = 0 To RejectDS.Tables(0).Rows.Count - 1
                RejectDR = RejectDS.Tables(0).Rows(r)
                If RejectDR("LotID") = MainDR("LotID") Then
                    For n As Int16 = 0 To RejectNamesDS.Tables(0).Rows.Count - 1
                        RejectNameDR = RejectNamesDS.Tables(0).Rows(n)
                        If RejectNameDR("DefectName") = RejectDR("DefectName") Then
                            Flex.SetCellValue(StartRowdata + m, 7 + n, RejectDR("RejectCount"))
                        End If
                    Next
                End If
            Next

            If Stage = "Laser Inspection" Then
                For S As Integer = 0 To SurfDS.Tables(0).Rows.Count - 1
                    SurfDR = SurfDS.Tables(0).Rows(S)
                    If SurfDR("ID#") = MainDR("LotID") Then
                        P_InfoSQL = "SELECT TOP 100 PERCENT ID_NUMBER, ISNULL(PARTICLE_SPEC_1, N'') + N' ' + ISNULL(PARTICLE_SPEC_2, N'') + N' ' + ISNULL(PARTICLE_SPEC_3, N'') + N' ' + ISNULL(PARTICLE_SPEC_4, N'') AS LPD, ISNULL(LPDN_Spec_1, N'') + N' ' + ISNULL(LPDN_Spec_2, N'') + N' ' + ISNULL(LPDN_Spec_3, N'') + N' ' + ISNULL(LPDN_Spec_4, N'') AS LPDN, ISNULL(SOD_Spec_1, N'') + N' ' + ISNULL(SOD_Spec_2, N'') + N' ' + ISNULL(SOD_Spec_3, N'') + N' ' + ISNULL(SOD_Spec_4, N'') AS SOD, ISNULL(LaserIDStation1, 'NR') AS Station1, ISNULL(LaserIDStation2, 'NR') AS Station2, ISNULL(LaserIDStation3, 'NR') AS Station3 FROM dbo.PROCESS_INFO WHERE (ID_NUMBER = N'" & SurfDR("ID#") & "') ORDER BY ID_NUMBER"
                        P_InfoDS = GetMyDataSet(P_InfoSQL)
                        P_InfoDR = P_InfoDS.Tables(0).Rows(0)

                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 1, SurfDR("Total"))

                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 3, SurfDR("Bin1") / SurfDR("Total"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 4, SurfDR("Bin1"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 5, P_InfoDR("Station1"))

                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 7, SurfDR("Bin2") / SurfDR("Total"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 8, SurfDR("Bin2"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 9, P_InfoDR("Station2"))

                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 11, SurfDR("Bin3") / SurfDR("Total"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 12, SurfDR("Bin3"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 13, P_InfoDR("Station3"))

                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 15, P_InfoDR("LPD"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 16, P_InfoDR("LPDN"))
                        Flex.SetCellValue(StartRowdata + m, 8 + Defect_Count + 17, P_InfoDR("SOD"))

                        Flex.SetCellFormat(StartRowdata + m, 8 + Defect_Count + 3, F_Precent)
                        Flex.SetCellFormat(StartRowdata + m, 8 + Defect_Count + 7, F_Precent)
                        Flex.SetCellFormat(StartRowdata + m, 8 + Defect_Count + 11, F_Precent)

                    End If
                Next
            End If
        Next

        For Header As Int16 = 0 To RejectNamesDS.Tables(0).Rows.Count - 1
            RejectNameDR = RejectNamesDS.Tables(0).Rows(Header)
            Flex.SetCellValue(StartRowHeader, 7 + Header, RejectNameDR("DefectName"))
        Next
        If Stage = "Laser Inspection" Then
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 1, "SP1 DB Records")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 3, "Bin 1 %")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 4, "Bin 1 Qty")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 5, "Bin 1 Label")

            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 7, "Bin 2 %")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 8, "Bin 2 Qty")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 9, "Bin 2 Label")

            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 11, "Bin 3 %")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 12, "Bin 3 Qty")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 13, "Bin 3 Label")

            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 15, "LPD")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 16, "LPDN")
            Flex.SetCellValue(StartRowHeader, 8 + Defect_Count + 17, "SOD")

        End If

        'Totals
        Dim TotalRow As Int16 = StartRowdata + MainDS.Tables(0).Rows.Count
        Flex.SetCellValue(TotalRow, 2, TotalQty)
        Flex.SetCellValue(TotalRow, 3, TotalRejects)
        Flex.SetCellValue(TotalRow, 4, TotalQty - TotalRejects)
        Flex.SetCellValue(TotalRow, 5, (TotalQty - TotalRejects) / TotalQty)

        'Grids
        For RC As Integer = 0 To MainDS.Tables(0).Rows.Count - 1
            For CC As Integer = 0 To RejectNamesDS.Tables(0).Rows.Count - 1
                Flex.SetCellFormat(StartRowdata + RC, 7 + CC, F_Border)
            Next
        Next



        Dim ReportName As String = "\\PWI-40\software$\LabelTemplates\LabelArchive\InvReportHold\KPI " & User.Identity.Name.ToString & "_" & Stage & ".xls"
        Flex.Save(ReportName)
        KPI_Data = ReportName


    End Function

    Function Get_Quick_SO_Info(SO As String) As Data.DataSet

        'SELECT TOP (100) PERCENT dbo.MainID.CustomerID, dbo.MainID.MainID, dbo.SO_LineItems.SO, dbo.SO_Info.PO_Number AS PO, dbo.SO_LineItems.Qty AS [PO Qty], SUM(dbo.ShippingInventory.Total_Qty) AS Shipped, dbo.SO_LineItems.Qty - SUM(dbo.ShippingInventory.Total_Qty) AS Balance FROM dbo.MainID INNER JOIN dbo.SO_LineItems ON dbo.MainID.MainID = dbo.SO_LineItems.MainID INNER JOIN dbo.SO_Info ON dbo.SO_LineItems.SO = dbo.SO_Info.SO LEFT OUTER JOIN dbo.ShippingInventory INNER JOIN dbo.Pick_Log ON dbo.ShippingInventory.PickTicket = dbo.Pick_Log.PickTicket ON dbo.SO_Info.SO = dbo.Pick_Log.SO GROUP BY dbo.MainID.MainID, dbo.SO_LineItems.SO, dbo.SO_Info.PO_Number, dbo.SO_LineItems.Qty, dbo.MainID.CustomerID HAVING (dbo.SO_LineItems.SO = N'075564') ORDER BY dbo.MainID.CustomerID, dbo.MainID.MainID
        Dim DS As Data.DataSet
        DS = GetMyDataSet("SELECT TOP (100) PERCENT dbo.MainID.CustomerID, dbo.MainID.MainID, dbo.SO_LineItems.SO, dbo.SO_Info.PO_Number AS PO, dbo.SO_LineItems.Qty AS [PO Qty], SUM(ISNULL(dbo.ShippingInventory.Total_Qty, 0)) AS Shipped, ISNULL(dbo.SO_LineItems.Qty - SUM(ISNULL(dbo.ShippingInventory.Total_Qty, 0)), 0) AS Balance FROM dbo.MainID INNER JOIN dbo.SO_LineItems ON dbo.MainID.MainID = dbo.SO_LineItems.MainID INNER JOIN dbo.SO_Info ON dbo.SO_LineItems.SO = dbo.SO_Info.SO LEFT OUTER JOIN dbo.ShippingInventory INNER JOIN dbo.Pick_Log ON dbo.ShippingInventory.PickTicket = dbo.Pick_Log.PickTicket ON dbo.SO_Info.SO = dbo.Pick_Log.SO GROUP BY dbo.MainID.MainID, dbo.SO_LineItems.SO, dbo.SO_Info.PO_Number, dbo.SO_LineItems.Qty, dbo.MainID.CustomerID HAVING (dbo.SO_LineItems.SO = N'" & SO & "') ORDER BY dbo.MainID.CustomerID, dbo.MainID.MainID")

        Return DS

    End Function


