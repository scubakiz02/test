    Function XML_Metal_Array(ByVal ParamArray Element() As Double) As Double()
        Element(2) = (Element(0) + Element(1)) / 2
        If Element(0) < Element(1) Then
            Element(3) = Element(0)
            Element(4) = Element(1)
        Else
            Element(3) = Element(1)
            Element(4) = Element(0)
        End If
        Element(5) = Element(4) - Element(2)
        XML_Metal_Array = Element
    End Function

