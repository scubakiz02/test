        DA.TableMappings.AddRange(New System.Data.Common.DataTableMapping() {New System.Data.Common.DataTableMapping("Table", "T_ShipmentsPending", New System.Data.Common.DataColumnMapping() {New System.Data.Common.DataColumnMapping("Key", "Key"), New System.Data.Common.DataColumnMapping("PickTicket", "PickTicket"), New System.Data.Common.DataColumnMapping("Operator", "Operator"), New System.Data.Common.DataColumnMapping("EventTime", "EventTime"), New System.Data.Common.DataColumnMapping("Released", "Released"), New System.Data.Common.DataColumnMapping("ReleasedDate", "ReleasedDate"), New System.Data.Common.DataColumnMapping("Notes", "Notes")})})
        DA.Fill(DS)

        Select Case action
            Case "Add"
                If DS.Tables(0).Rows.Count = 0 Then
                    DR = DS.Tables("T_ShipmentsPending").NewRow
                    DR("PickTicket") = PickTicket
                    DR("Operator") = Op
                    DR("EventTime") = DateTime.Now.ToShortTimeString
                    DR("Released") = "No"
                    DR("Notes") = Note

                    DS.Tables("T_ShipmentsPending").Rows.Add(DR)
                    DA.Update(DS, "T_ShipmentsPending")
                End If

            Case "Release"

                'What if it has been released already?
                If DS.Tables(0).Rows.Count = 0 Then
                    Return ("Not in Pending Shipment!")
                    Exit Function
                End If

                DR = DS.Tables(0).Rows(0)
                DR.AcceptChanges()
                DR.BeginEdit()
                DR("Released") = "Yes"
                DR("ReleasedDate") = DateTime.Now.ToShortDateString
                DR.EndEdit()
                DA.Update(DS, "T_ShipmentsPending")

        End Select



        Connection.Close()
        Return ("Good")
    End Function

    Function GetPalletKey(PickTicket As String) As String
