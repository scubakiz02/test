    Function IDForSP1Reciver(ByVal MainID As String, ByVal RecevierStation As String) As String

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()

        Dim DA_PInfoID As New Data.SqlClient.SqlDataAdapter
        Dim DS_PInfoID As New Data.DataSet
        Dim DR_PInfoID As Data.DataRow

        Dim PInfoIDSelectCmd As New System.Data.SqlClient.SqlCommand
        With PInfoIDSelectCmd
            .CommandText = "SELECT ID_NUMBER, LaserIDStation1, LaserIDStation2, LaserIDStation3, ExpirationDtd FROM dbo.PROCESS_INFO WHERE (ID_NUMBER = N'" & MainID & "') AND (ExpirationDtd > { fn NOW() } OR ExpirationDtd IS NULL)"
            .Connection = Connection
        End With
        DA_PInfoID.SelectCommand = PInfoIDSelectCmd
        DA_PInfoID.Fill(DS_PInfoID)
        Try
            DR_PInfoID = DS_PInfoID.Tables(0).Rows(0)
            Select Case RecevierStation
                Case "1"
                    IDForSP1Reciver = DR_PInfoID("LaserIDStation1").ToString
                Case "2"
                    IDForSP1Reciver = DR_PInfoID("LaserIDStation2").ToString
                Case "3"
                    IDForSP1Reciver = DR_PInfoID("LaserIDStation3").ToString
                Case Else
                    IDForSP1Reciver = MainID
            End Select
        Catch ex As Exception
            IDForSP1Reciver = MainID
        End Try

        Connection.Close()

    End Function

    Function GetLabelTemplateForID(ByVal MainID As String, ByVal TemplateType As String, ByVal StageName As String) As String

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()

        Dim DA_Template As New Data.SqlClient.SqlDataAdapter
        Dim DS_Template As New Data.DataSet
        Dim DR_Template As Data.DataRow

        Dim TemplateSelectCmd As New System.Data.SqlClient.SqlCommand
        With TemplateSelectCmd
            .CommandText = "SELECT dbo.LabelTemplatesDotNet.Template FROM dbo.MainID_Template INNER JOIN dbo.LabelTemplatesDotNet ON dbo.MainID_Template.Template_Key = dbo.LabelTemplatesDotNet.[Key] WHERE (dbo.MainID_Template.MainID = N'" & MainID & "') AND (dbo.MainID_Template.Template_Type = N'" & TemplateType & "') AND (dbo.MainID_Template.StageName = N'" & StageName & "') AND (dbo.MainID_Template.ExpirationDtd > { fn NOW() } OR dbo.MainID_Template.ExpirationDtd IS NULL)"
            .Connection = Connection
        End With
        DA_Template.SelectCommand = TemplateSelectCmd
        DA_Template.Fill(DS_Template)

        Try
            DR_Template = DS_Template.Tables(0).Rows(0)
            GetLabelTemplateForID = DR_Template("Template")
        Catch ex As Exception
            GetLabelTemplateForID = "BAD"
        End Try
        Connection.Close()

    End Function

    Function MakeNewUpdatedLabel_300Only(ByVal WBLabel As String, ByVal ThePrinter As String, ByVal theuser As String) As String 'Gets the newes po or spec and kills the old label
        Dim MainID As String
        Dim TheLotNumber As String
        Dim Qty As String
        Dim IKey As String
        Dim Carton As String

        If Not Mid(WBLabel, 1, 2) = "WB" Then
            MakeNewUpdatedLabel_300Only = "Error, Not a Wafer Box Label"
            Exit Function
        End If
        WBLabel = Mid(WBLabel, 3)

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()

        Dim DA_OldWBInfo As New Data.SqlClient.SqlDataAdapter
        Dim DS_OldWBInfo As New Data.DataSet
        Dim OldWBInfoSelectCmd As New System.Data.SqlClient.SqlCommand
        Dim DR_OldWBInfo As Data.DataRow
        With OldWBInfoSelectCmd
            .CommandText = "SELECT dbo.T_FGI_Boxes.BoxInvNumber, dbo.T_FGI_Boxes.LabelsMadeKey, dbo.T_FGI_Boxes.InstanceKey, dbo.T_FGI_Boxes.CartonNumber, dbo.LabelsMade.LabelRecordNumber, dbo.LabelsMade.Lot, dbo.LabelsMade.Wafers, dbo.LabelsMade.RFID FROM dbo.T_FGI_Boxes INNER JOIN dbo.LabelsMade ON dbo.T_FGI_Boxes.LabelsMadeKey = dbo.LabelsMade.LabelRecordNumber WHERE (dbo.T_FGI_Boxes.BoxInvNumber = " & WBLabel & ")"
            .Connection = Connection
        End With
        DA_OldWBInfo.SelectCommand = OldWBInfoSelectCmd
        Try
            DA_OldWBInfo.Fill(DS_OldWBInfo)
            DR_OldWBInfo = DS_OldWBInfo.Tables(0).Rows(0)
        Catch ex As Exception
            MakeNewUpdatedLabel_300Only = "Error, Wafer Box Label Not Found"
            Exit Function
        End Try


        'Get *******
        'Get The Lot Number
        TheLotNumber = DR_OldWBInfo("Lot")
        'Get Main ID
        MainID = Mid(TheLotNumber, 1, 4)
        'Get the Qty of the label
        Qty = DR_OldWBInfo("Wafers")
        'Get The IKey
        IKey = DR_OldWBInfo("InstanceKey")

        'Make New Label
        MakeNewUpdatedLabel_300Only = MakeLabel(False, "WB", "PWC", MainID, TheLotNumber, Qty, 1, IKey, ThePrinter, "", 0, "", "", New Data.DataSet, "WB", DR_OldWBInfo("RFID"), theuser, False, 0)
        If Not MakeNewUpdatedLabel_300Only.Contains("Error") Then
            'Remove and old records from FGI
            Try
                Carton = DR_OldWBInfo("CartonNumber")
                ShippingInvTable("Delete", Carton, "", "", "", "", "")
                MakeNewUpdatedLabel_300Only = "Removed From FGI..."
            Catch ex As Exception
                MakeNewUpdatedLabel_300Only = ""
            End Try
        End If

        Connection.Close()
    End Function

    Function MakeNewUpdatedLabel_OldSystem(ByVal WBLabel As String, ByVal ThePrinter As String, ByVal TheUser As String) As String 'Gets the newes po or spec and kills the old label
        Dim MainID As String
        Dim TheLotNumber As String
        Dim Qty As String

        If Not Mid(WBLabel, 1, 1) = "W" Then
            MakeNewUpdatedLabel_OldSystem = "Error, Not a Wafer Box Label"
            Exit Function
        End If
        WBLabel = Mid(WBLabel, 2)

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()

        Dim DA_OldWBInfo As New Data.SqlClient.SqlDataAdapter
        Dim DS_OldWBInfo As New Data.DataSet
        Dim OldWBInfoSelectCmd As New System.Data.SqlClient.SqlCommand
        Dim DR_OldWBInfo As Data.DataRow
        With OldWBInfoSelectCmd
            .CommandText = "SELECT LabelRecordNumber, Lot, Wafers, Total_Qty FROM dbo.LabelsMade WHERE (LabelRecordNumber = " & WBLabel & ")"
            .Connection = Connection
        End With
        DA_OldWBInfo.SelectCommand = OldWBInfoSelectCmd
        Try
