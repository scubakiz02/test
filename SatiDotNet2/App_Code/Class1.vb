    Function Bulk_Final_QA(LotNumber As String) As String
        Dim MySQL As String = ""
        Dim MyID As String = Mid(LotNumber, 1, 4)
        Dim MyNote As String = ""

        Dim RC As Integer = 0
        Dim I As Integer = 0

        Dim DS_Spec As New Data.DataSet
        Dim DS_Geo As New Data.DataSet
        Dim DS_Partical As New Data.DataSet

        Dim DR_Spec As Data.DataRow
        Dim DR_ResSpec As Data.DataRow
        Dim DR_Geo As Data.DataRow
        Dim DR_Partical As Data.DataRow

        Dim Trip As Boolean = False

        '***********************************************************************************************************************************************************************************************************************************************************************************************
        '***********************************************************************************************************************************************************************************************************************************************************************************************
        'ID Spec info
        MySQL = "SELECT  '" & LotNumber & "' AS Lot, dbo.MainID.MainID, dbo.MainID.CustomerID, dbo.MainID.Diameter, dbo.Q_Process_Info_GreenCatieFinalSpecs.Type, dbo.Q_Process_Info_GreenCatieFinalSpecs.MinThick, dbo.Q_Process_Info_GreenCatieFinalSpecs.MaxThick, dbo.Q_Process_Info_GreenCatieFinalSpecs.TTV, dbo.Q_Process_Info_GreenCatieFinalSpecs.TIR, dbo.Q_Process_Info_GreenCatieFinalSpecs.STIR, dbo.Q_Process_Info_GreenCatieFinalSpecs.MinRes, dbo.Q_Process_Info_GreenCatieFinalSpecs.MaxRes, dbo.Q_Process_Info_GreenCatieFinalSpecs.Bow, dbo.Q_Process_Info_GreenCatieFinalSpecs.Warp, dbo.Q_Process_Info_GreenCatieFinalSpecs.PARTICLE_SPEC_1, dbo.Q_Process_Info_GreenCatieFinalSpecs.PARTICLE_SPEC_2, dbo.Q_Process_Info_GreenCatieFinalSpecs.PARTICLE_SPEC_3, dbo.Q_Process_Info_GreenCatieFinalSpecs.PARTICLE_SPEC_4, dbo.Q_Process_Info_GreenCatieFinalSpecs.LPDN_Spec_1, dbo.Q_Process_Info_GreenCatieFinalSpecs.LPDN_Spec_2, dbo.Q_Process_Info_GreenCatieFinalSpecs.LPDN_Spec_3, dbo.Q_Process_Info_GreenCatieFinalSpecs.LPDN_Spec_4, dbo.Q_Process_Info_GreenCatieFinalSpecs.SOD_Spec_1, dbo.Q_Process_Info_GreenCatieFinalSpecs.SOD_Spec_2, dbo.Q_Process_Info_GreenCatieFinalSpecs.SOD_Spec_3, dbo.Q_Process_Info_GreenCatieFinalSpecs.SOD_Spec_4, dbo.CofA_Info.First_Bin, dbo.CofA_Info.Second_Bin, dbo.CofA_Info.Third_Bin, dbo.CofA_Info.Forth_Bin, dbo.CofA_Info.LPD, dbo.CofA_Info.LPDN, dbo.CofA_Info.SOD, dbo.CofA_Info.MAIN_ID FROM dbo.MainID INNER JOIN dbo.Q_Process_Info_GreenCatieFinalSpecs ON dbo.MainID.MainID = dbo.Q_Process_Info_GreenCatieFinalSpecs.ID_NUMBER INNER JOIN dbo.CofA_Info ON dbo.Q_Process_Info_GreenCatieFinalSpecs.ID_NUMBER = dbo.CofA_Info.ID_NUMBER WHERE (dbo.MainID.MainID = N'" & MyID & "')"
        DS_Spec = GetMyDataSet(MySQL)

        MyNote = MyNote & "Bulk_Final_QA Results. <br/> <br/>"
        MyNote = MyNote & "Lot Number: " & LotNumber & "<br/>"


        If DS_Spec.Tables(0).Rows.Count = 0 Then 'Check if we found spec data
            MyNote = MyNote & "Cant find Spec Data, "
            Return MyNote
            Exit Function
        End If

        'Lot Geo Data
        DR_ResSpec = GetIDSpec(MyID)
        DS_Geo = GetBulkCofAData_Geo(DS_Spec, MyID, DR_ResSpec)

        'Lot Partical Data
        DS_Partical = GetBulkCofAData_Partical(DS_Spec, MyID, True)


        'Let look to see if there is even any tool data to look at
        If DS_Geo.Tables(0).Rows.Count = 0 Then
            MyNote = MyNote & "Missing Geo Lot Data <br/>"
            Trip = True
        Else
            MyNote = MyNote & "GEO records = " & DS_Geo.Tables(0).Rows.Count & "<br/>"
        End If

        If DS_Partical.Tables(0).Rows.Count = 0 Then
            MyNote = MyNote & "Missing Partical Lot Data <br/>"
            Trip = True
        Else
            MyNote = MyNote & "Partical records = " & DS_Partical.Tables(0).Rows.Count & "<br/> <br/>"
        End If
        '***********************************************************************************************************************************************************************************************************************************************************************************************
        '***********************************************************************************************************************************************************************************************************************************************************************************************
        If Trip = True Then
            SendMail365(MyNote, "200mm QA Check", "AZ.Sati.QA.200mm@purewafer.com", "SATI@purewafer.com")
            Return MyNote
            Exit Function
        End If

        DR_Spec = DS_Spec.Tables(0).Rows(0)


        '=============================================
        '=============== GEO =========================
        '=============================================
        RC = DS_Geo.Tables(0).Rows.Count


        '*************************************************************
        'Type = spec
