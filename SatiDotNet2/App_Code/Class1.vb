        If DR("InstanceKey").ToString = "50" Then
            Return "PASS"
            Exit Function
        End If


        DR = MyDS.Tables(0).Rows(0)

        Select Case DR("MainID").ToString
            Case "3361", "3362", "3363", "3087", "3110"
                ' Look for start with "48" Scribe
                I = 0
                For I = 0 To BoxCount - 1
                    DR = MyDS.Tables(0).Rows(I)
                    If Left(DR("T7").ToString, 2) = "48" Then
                        Return "Error, This box has 48 scribe! " '>< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< ><
                        Exit Function
                    End If
                Next
        End Select

        If IS_RFID_Enable(DR("MainID")) = True Then
            If DR("RFIDChecked") = False Then
                Return "Error, RFID was not Verified! " '>< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< ><
                Exit Function
            End If
        End If

        If DR("RFIDChecked") = True Then
            If DR("LabelRFID").ToString.Contains("No") Or DR("LabelRFID").ToString.Contains("Error") Or DR("LabelRFID").ToString = "" Then
                Return "Error, RFID Not Defined!" '>< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< ><
                Exit Function
            Else
                I = 0
                For I = 0 To BoxCount - 1
                    DR = MyDS.Tables(0).Rows(I)
                    If Not DR("LabelRFID").ToString = DR("SurfRecordRFID").ToString Then
                        'add fix**********
                        Return "Error, Missing RFID!" '>< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< ><
                        Exit Function
                    End If
                Next
            End If
        End If



        '**********************
        ' T7 BlackList Check **
        '**********************

        I = 0
        Dim Blacklist_Info As String

        For I = 0 To BoxCount - 1
            DR = MyDS.Tables(0).Rows(I)
            Blacklist_Info = Check_T7_BlackList(DR("T7"), "FGI")

            If Not Blacklist_Info = "" Then
                Return "T7 Blacklist, " & DR("T7") & " " & Blacklist_Info '>< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< >< ><
