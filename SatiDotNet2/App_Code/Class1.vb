    Function MakeWaferTechDataPack(ByVal flex As FlexCel.XlsAdapter.XlsFile) As Boolean
        flex.ActiveSheetByName = "C of A"

        ' make datestring
        Dim mydateString As String
        Dim mydateStringdash As String
        mydateString = DateTime.Now.Year.ToString
        mydateStringdash = DateTime.Now.Year.ToString & "-"
        If DateTime.Now.Month < 10 Then
            mydateString = mydateString & "0" & DateTime.Now.Month.ToString
            mydateStringdash = mydateStringdash & "0" & DateTime.Now.Month.ToString & "-"
        Else
            mydateString = mydateString & DateTime.Now.Month.ToString
            mydateStringdash = mydateStringdash & DateTime.Now.Month.ToString & "-"
        End If
        If DateTime.Now.Day < 10 Then
            mydateString = mydateString & "0" & DateTime.Now.Day.ToString
            mydateStringdash = mydateStringdash & "0" & DateTime.Now.Day.ToString
        Else
            mydateString = mydateString & DateTime.Now.Day.ToString
            mydateStringdash = mydateStringdash & DateTime.Now.Day.ToString
        End If

        'E5606.20100826.130000.E5606.20100826.PWI_QUAL_32000071.XML
        'Dim XMLFileName As String = "\\PWI-40\software$\LabelTemplates\LabelArchive\WaferTechDataPacks\" & flex.GetCellValue(3, 8).ToString & ".xml"
        Dim XMLFileName As String = "\\PWI-40\software$\LabelTemplates\LabelArchive\WaferTechDataPacks\E5606."
        XMLFileName = XMLFileName & mydateString
        XMLFileName = XMLFileName & ".PWI_"
        XMLFileName = XMLFileName & flex.GetCellValue(3, 8).ToString & "_" 'ship#
        XMLFileName = XMLFileName & flex.GetCellValue(7, 3).ToString
        XMLFileName = XMLFileName & ".xml"

        Dim settings As New XmlWriterSettings()
        settings.Indent = True
        settings.IndentChars = "    "

        Using XWriter As XmlWriter = XmlWriter.Create(XMLFileName)

            XWriter.WriteStartDocument() 'write start version
            XWriter.WriteComment("Created @ " & DateTime.Now.ToString()) 'write comment


            XWriter.WriteStartElement("Wafer_Shipment") 'Start "Wafer_Shipment" Element +++++++++++++++++++++++++++++++++++++++++++++
            XWriter.WriteAttributeString("MaterialNo", flex.GetCellValue(7, 3).ToString) 'Part# 'Attributes 
            XWriter.WriteAttributeString("SupplierID", "5606") 'Write "Main" Elements Attributes
            XWriter.WriteAttributeString("PONo", flex.GetCellValue(13, 2).ToString) 'Write "Main" Elements Attributes
            XWriter.WriteAttributeString("TSMCFab", "") 'Write "Main" Elements Attributes
            XWriter.WriteAttributeString("ManufacturingSite", "PRESCOTT") 'Write "Main" Elements Attributes
            XWriter.WriteAttributeString("InvoiceNo", flex.GetCellValue(3, 8).ToString) 'Write "Main" Elements Attributes

            If flex.GetCellValue(20, 3).ToString.Contains("P/") Then
                XWriter.WriteAttributeString("ConductivityType", "P") 'Write "Main" Elements Attributes
            End If
            If flex.GetCellValue(20, 3).ToString.Contains("N/") Then
                XWriter.WriteAttributeString("ConductivityType", "N") 'Write "Main" Elements Attributes
