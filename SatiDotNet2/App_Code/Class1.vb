    Sub setMDL(elem As String, liveMdlDR As Data.DataRow, DR As Data.DataRow, DR_Metals As Data.DataRow)
        Dim R As Double = 0
        Dim M As Int16 = 0
        Dim MyNull As Object
        Dim LiveMdlVal As Double = liveMdlDR(elem)
        MyNull = System.DBNull.Value

        If DR_Metals(elem) Is MyNull Then
            R = GetRandomNumber(9, 1) / 1000
            M = GetRandomNumber(3, 1)
            If M = 1 Then
                DR(elem) = LiveMdlVal + R
            Else
                Dim valInQ As Double = LiveMdlVal - R

                If (valInQ > 0) Then
                    DR(elem) = valInQ
                Else
                    DR(elem) = LiveMdlVal
                End If
            End If
        Else
            DR(elem) = DR_Metals(elem)
        End If
    End Sub



    Function Data_Enlightenment_Camp(BoxType As String, Box As String, Info As String) As String

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()
        Dim DA As New Data.SqlClient.SqlDataAdapter
        Dim DS As New Data.DataSet
        Dim DR As Data.DataRow
        Dim PreRemoval As Double
        Dim SelectCmd As New System.Data.SqlClient.SqlCommand
        With SelectCmd
            Select Case BoxType
                Case = "I"
                    .CommandText = "SELECT dbo.T7_InstanceInfo.Slot, dbo.T7_InstanceInfo.WAT_Key, dbo.T7_WaferActionTracking.PreGeo_Key, dbo.T7_GeoData.CenterThick AS PreThick, dbo.T7_WaferActionTracking.PostGeo_Key, T7_GeoData_1.CenterThick AS PostThick, dbo.T7_GeoData.CenterThick - T7_GeoData_1.CenterThick AS Removal FROM dbo.T7_GeoData AS T7_GeoData_1 RIGHT OUTER JOIN dbo.T7_WaferActionTracking INNER JOIN dbo.T7_InstanceInfo ON dbo.T7_WaferActionTracking.WAT_Key = dbo.T7_InstanceInfo.WAT_Key INNER JOIN dbo.T_FGI_Boxes ON dbo.T7_InstanceInfo.InstanceID = dbo.T_FGI_Boxes.InstanceKey ON T7_GeoData_1.Geo_Key = dbo.T7_WaferActionTracking.PostGeo_Key LEFT OUTER JOIN dbo.T7_GeoData ON dbo.T7_WaferActionTracking.PreGeo_Key = dbo.T7_GeoData.Geo_Key WHERE (dbo.T_FGI_Boxes.InstanceKey = " & Box & ") ORDER BY dbo.T7_InstanceInfo.Slot"
                Case = "WB"
                    .CommandText = "SELECT dbo.T7_InstanceInfo.Slot, dbo.T7_InstanceInfo.WAT_Key, dbo.T7_WaferActionTracking.PreGeo_Key, dbo.T7_GeoData.CenterThick AS PreThick, dbo.T7_WaferActionTracking.PostGeo_Key, T7_GeoData_1.CenterThick AS PostThick, dbo.T7_GeoData.CenterThick - T7_GeoData_1.CenterThick AS Removal FROM dbo.T7_GeoData AS T7_GeoData_1 RIGHT OUTER JOIN dbo.T7_WaferActionTracking INNER JOIN dbo.T7_InstanceInfo ON dbo.T7_WaferActionTracking.WAT_Key = dbo.T7_InstanceInfo.WAT_Key INNER JOIN dbo.T_FGI_Boxes ON dbo.T7_InstanceInfo.InstanceID = dbo.T_FGI_Boxes.InstanceKey ON T7_GeoData_1.Geo_Key = dbo.T7_WaferActionTracking.PostGeo_Key LEFT OUTER JOIN dbo.T7_GeoData ON dbo.T7_WaferActionTracking.PreGeo_Key = dbo.T7_GeoData.Geo_Key WHERE (dbo.T_FGI_Boxes.BoxInvNumber = " & Box & ") ORDER BY dbo.T7_InstanceInfo.Slot"
                Case = "CB"
