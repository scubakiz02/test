    Function Run_300mm_FGI_Scan() As String
        Dim MySQL As String = "SELECT TOP (100) PERCENT ID, Carton_Key FROM dbo.Q_FGI_W_KEY WHERE (ID LIKE N'3%') ORDER BY ID"
        Dim MyDS As Data.DataSet
        Dim DR As Data.DataRow
        Dim InvCount As Int16
        MyDS = GetMyDataSet(MySQL)
        InvCount = MyDS.Tables(0).Rows.Count

        Dim FILE_NAME As String = "\\PWI-40\software$\LabelTemplates\LabelArchive\InvReportHold\300mmFGIscan.txt"
        Using sw As StreamWriter = File.CreateText(FILE_NAME)
            sw.WriteLine(System.DateTime.Now.ToLongDateString & "  " & System.DateTime.Now.ToLongTimeString)
            sw.WriteLine("300mm FGI QA Scan Report.")
            sw.WriteLine("")
            sw.WriteLine("Found " & InvCount & " FGI Cartons.")
            sw.WriteLine("")
            For i As Integer = 0 To InvCount - 1
                DR = MyDS.Tables(0).Rows(i)
                sw.Write("ID: ")
                sw.Write(DR("ID").ToString)
                sw.Write(", Carton: ")
                sw.Write(DR("Carton_Key").ToString)
                sw.Write(", Scan: ")
                sw.WriteLine(CheckWaferBoxData("CB", DR("Carton_Key")))
            Next
            sw.WriteLine("")
            sw.WriteLine("********************************************************************")
            sw.WriteLine("Report End")
            sw.WriteLine(System.DateTime.Now.ToLongDateString & "  " & System.DateTime.Now.ToLongTimeString)
            sw.Close()
        End Using


    End Function

