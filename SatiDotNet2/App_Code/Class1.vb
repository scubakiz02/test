        'Do Until Bla = False
        'Try
        'T7 = flex.GetCellValue(I, 3).ToString ' in try so if it gets a blank null
        'sw.WriteLine(T7 & "," & PartName & ",PURE WAFER," & PartNumber)
        'Catch ex As Exception
        'Bla = False
        'End Try
        'I = I + 1
        'Loop

        'sw.Close()
        'End Using



        'Create file and fill .Xls
        Bla = True
        I = 3

        Dim FlexNew As New FlexCel.XlsAdapter.XlsFile(True)
