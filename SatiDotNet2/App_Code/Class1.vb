        FlexNew.Open(Path)
        FlexNew.ActiveSheetByName = "IMEC"

        flex.ActiveSheetByName = "Slot-by-Slot"
        Do Until Bla = False
            Try
                T7 = flex.GetCellValue(I, 3).ToString ' in try so if it gets a blank null
