    Function DiameterRandom(Diameter As Int16, num As Integer) As Double


        Select Case Diameter
            Case 200
                Select Case num
                    Case 1 '199.85
                        DiameterRandom = 199.85
                        Exit Function
                    Case 2 '199.90
                        DiameterRandom = 199.9
                        Exit Function
                    Case 3 '199.95
                        DiameterRandom = 199.95
                        Exit Function
                    Case 4 To 47 '200.00
                        DiameterRandom = 200
                        Exit Function
                    Case 48 '200.05
                        DiameterRandom = 200.05
                        Exit Function
                    Case 49 '200.10
                        DiameterRandom = 200.1
                        Exit Function
                    Case 50 '200.15
                        DiameterRandom = 200.15
                        Exit Function
                End Select

            Case 300
                Select Case num
                    Case 1
                        Return 299.85
                        Exit Function
                    Case 2
                        Return 299.9
                        Exit Function
                    Case 3
                        Return 299.95
                        Exit Function
                    Case 4 To 47
                        Return 300
                        Exit Function
                    Case 48
                        Return 300.05
                        Exit Function
                    Case 49
                        Return 300.1
                        Exit Function
                    Case 50
                        Return 300.15
                        Exit Function
                End Select

        End Select

    End Function







