                    Gather = False
                End Try
                PointerStart = PointerEnd
            Loop


            XWriter.WriteEndElement() 'Close "Wafer_Shipment" Element ---------------------------------------------

            XWriter.Close()
        End Using


    End Function


    Function MakeFreeScaleDataPack(ByVal flex As FlexCel.XlsAdapter.XlsFile) As Boolean
        Dim Partical_12 As String = ".12"
        Dim Partical_16 As String = ".16"
        Dim Partical_2 As String = ".2"
        Dim Partical_3 As String = ".3"

        Dim ParticalBinCol_12 As Int16 = 0
        Dim ParticalBinCol_16 As Int16 = 0
        Dim ParticalBinCol_2 As Int16 = 0
        Dim ParticalBinCol_3 As Int16 = 0

        Dim Cover As String = "C of A"

        Dim LF As String = " &#xA "

        If flex.ActiveSheetByName.Contains("C of A") = True Then
            Cover = flex.SheetName
        End If

        flex.ActiveSheetByName = Cover '"C of A"


        ' make datestring
        Dim mydateString As String
        Dim mydateStringdash As String
        mydateString = DateTime.Now.Year.ToString
        mydateStringdash = DateTime.Now.Year.ToString & "-"
        If DateTime.Now.Month < 10 Then
            mydateString = mydateString & "0" & DateTime.Now.Month.ToString
            mydateStringdash = mydateStringdash & "0" & DateTime.Now.Month.ToString & "-"
        Else
            mydateString = mydateString & DateTime.Now.Month.ToString
            mydateStringdash = mydateStringdash & DateTime.Now.Month.ToString & "-"
        End If
        If DateTime.Now.Day < 10 Then
            mydateString = mydateString & "0" & DateTime.Now.Day.ToString
            mydateStringdash = mydateStringdash & "0" & DateTime.Now.Day.ToString
        Else
            mydateString = mydateString & DateTime.Now.Day.ToString
            mydateStringdash = mydateStringdash & DateTime.Now.Day.ToString
        End If

        Dim fab As String = FreeScaleFabFind(flex.GetCellValue(11, 2).ToString)
        Dim Shipment As String = flex.GetCellValue(3, 8).ToString

        Dim XMLFileName As String = "\\PWI-40\software$\LabelTemplates\LabelArchive\FreeScaleDataPacks\"
        XMLFileName = XMLFileName & flex.GetCellValue(7, 3).ToString & "_" ' PartNumber
        XMLFileName = XMLFileName & Shipment.Replace("-", "") & "_" 'Shiping number
        XMLFileName = XMLFileName & fab & ".xml" 'Fab



        Dim settings As New XmlWriterSettings()
        settings.Indent = True
        settings.IndentChars = "    "
        settings.NewLineChars = vbCrLf


        Using XWriter As XmlWriter = XmlWriter.Create(XMLFileName, settings)


            XWriter.WriteStartDocument() 'write start version

            XWriter.WriteComment("Created @ " & DateTime.Now.ToString()) 'write comment


            XWriter.WriteStartElement("Shipment") 'Start Element +++++++++++++++++++++++++++++++++++++++++++++
            XWriter.WriteAttributeString("PartID", flex.GetCellValue(7, 3).ToString)
            XWriter.WriteAttributeString("Supplier", "PWI")
            XWriter.WriteAttributeString("ShipTo", "")
            XWriter.WriteAttributeString("SpecNo", flex.GetCellValue(9, 3).ToString)
            XWriter.WriteAttributeString("SpecRev", flex.GetCellValue(9, 7).ToString)
            XWriter.WriteAttributeString("MfgSiteId", "Prescott")
            XWriter.WriteAttributeString("Invoice", flex.GetCellValue(3, 8).ToString)
            XWriter.WriteAttributeString("PO", flex.GetCellValue(13, 2).ToString)
            XWriter.WriteAttributeString("Dopant", flex.GetCellValue(20, 3).ToString)
            XWriter.WriteAttributeString("IngotOrientation", flex.GetCellValue(21, 3).ToString)
            XWriter.WriteAttributeString("ShipQty", flex.GetCellValue(15, 2).ToString)
            XWriter.WriteAttributeString("ShipDate", mydateStringdash)

            'Find out How many Lots

            Dim lots As Int16 = 0
            For i As Int16 = 0 To 9
                If i <= 4 Then
                    Try
                        If Not flex.GetCellValue(11 + i, 4).ToString = "" Then
                            lots = lots + 1
                        End If
                    Catch ex As Exception
                        Exit For
                    End Try

                Else
                    Try
                        If Not flex.GetCellValue((11 + i) - 5, 7).ToString = "" Then
                            lots = lots + 1
                        End If
                    Catch ex As Exception
                        If Not flex.GetCellValue((11 + i) - 5, 6).ToString = "" Then
                            lots = lots + 1
                        End If
                    End Try

                End If


            Next
            'find Metals sheet

            Dim Ca(0 To 5) As Double
            Dim Ma(0 To 5) As Double
            Dim Ni(0 To 5) As Double
            Dim Zn(0 To 5) As Double
            Dim Al(0 To 5) As Double
            Dim Fe(0 To 5) As Double
            Dim Cr(0 To 5) As Double
            Dim Cu(0 To 5) As Double
            Dim Na(0 To 5) As Double
            Dim K(0 To 5) As Double

            Dim MetalsSheet As String
            Try
                flex.ActiveSheetByName = "Metal"
                MetalsSheet = "Metal"
                Ca(0) = flex.GetCellValue(5, 11).ToString
                Ca(1) = flex.GetCellValue(5, 12).ToString
                Ma(0) = flex.GetCellValue(6, 11).ToString
                Ma(1) = flex.GetCellValue(6, 12).ToString
                Ni(0) = flex.GetCellValue(7, 11).ToString
                Ni(1) = flex.GetCellValue(7, 12).ToString
                Zn(0) = flex.GetCellValue(8, 11).ToString
                Zn(1) = flex.GetCellValue(8, 12).ToString
                Al(0) = flex.GetCellValue(9, 11).ToString
                Al(1) = flex.GetCellValue(9, 12).ToString
                Fe(0) = flex.GetCellValue(10, 11).ToString
                Fe(1) = flex.GetCellValue(10, 12).ToString
                Cr(0) = flex.GetCellValue(11, 11).ToString
                Cr(1) = flex.GetCellValue(11, 12).ToString
                Cu(0) = flex.GetCellValue(12, 11).ToString
                Cu(1) = flex.GetCellValue(12, 12).ToString
                Na(0) = flex.GetCellValue(13, 11).ToString
                Na(1) = flex.GetCellValue(13, 12).ToString
                K(0) = flex.GetCellValue(14, 11).ToString
                K(1) = flex.GetCellValue(14, 12).ToString


            Catch ex As Exception

            End Try



            Ca = XML_Metal_Array(Ca)
            Ma = XML_Metal_Array(Ma)
            Ni = XML_Metal_Array(Ni)
            Zn = XML_Metal_Array(Zn)
            Al = XML_Metal_Array(Al)
            Fe = XML_Metal_Array(Fe)
            Cr = XML_Metal_Array(Cr)
            Cu = XML_Metal_Array(Cu)
            Na = XML_Metal_Array(Na)
            K = XML_Metal_Array(K)


            flex.ActiveSheetByName = Cover

            'Find what particals are used
            'find bins

            '0.12
            Try
                If flex.GetCellValue(37, 3).ToString.Contains(Partical_12) Then
                    ParticalBinCol_12 = 37
                End If
                If flex.GetCellValue(38, 3).ToString.Contains(Partical_12) Then
                    ParticalBinCol_12 = 38
                End If
                If flex.GetCellValue(39, 3).ToString.Contains(Partical_12) Then
                    ParticalBinCol_12 = 39
                End If
                If flex.GetCellValue(40, 3).ToString.Contains(Partical_12) Then
                    ParticalBinCol_12 = 40
                End If
                If flex.GetCellValue(41, 3).ToString.Contains(Partical_12) Then
                    ParticalBinCol_12 = 41
                End If
                If flex.GetCellValue(42, 3).ToString.Contains(Partical_12) Then
                    ParticalBinCol_12 = 42
                End If
            Catch ex As Exception

            End Try

            '0.16
            Try
                If flex.GetCellValue(37, 3).ToString.Contains(Partical_16) Then
                    ParticalBinCol_16 = 37
                End If
                If flex.GetCellValue(38, 3).ToString.Contains(Partical_16) Then
                    ParticalBinCol_16 = 38
                End If
                If flex.GetCellValue(39, 3).ToString.Contains(Partical_16) Then
                    ParticalBinCol_16 = 39
                End If
                If flex.GetCellValue(40, 3).ToString.Contains(Partical_16) Then
                    ParticalBinCol_16 = 40
                End If
                If flex.GetCellValue(41, 3).ToString.Contains(Partical_16) Then
                    ParticalBinCol_16 = 41
                End If
                If flex.GetCellValue(42, 3).ToString.Contains(Partical_16) Then
                    ParticalBinCol_16 = 42
                End If
            Catch ex As Exception

            End Try

            '0.2
            Try
                If flex.GetCellValue(37, 3).ToString.Contains(Partical_2) Then
                    ParticalBinCol_2 = 37
                End If
                If flex.GetCellValue(38, 3).ToString.Contains(Partical_2) Then
                    ParticalBinCol_2 = 38
                End If
                If flex.GetCellValue(39, 3).ToString.Contains(Partical_2) Then
                    ParticalBinCol_2 = 39
                End If
                If flex.GetCellValue(40, 3).ToString.Contains(Partical_2) Then
                    ParticalBinCol_2 = 40
                End If
                If flex.GetCellValue(41, 3).ToString.Contains(Partical_2) Then
                    ParticalBinCol_2 = 41
                End If
                If flex.GetCellValue(42, 3).ToString.Contains(Partical_2) Then
                    ParticalBinCol_2 = 42
                End If
            Catch ex As Exception

            End Try

            Try
                If flex.GetCellValue(37, 3).ToString.Contains(Partical_3) Then
                    ParticalBinCol_3 = 37
                End If
                If flex.GetCellValue(38, 3).ToString.Contains(Partical_3) Then
                    ParticalBinCol_3 = 38
                End If
                If flex.GetCellValue(39, 3).ToString.Contains(Partical_3) Then
                    ParticalBinCol_3 = 39
                End If
                If flex.GetCellValue(40, 3).ToString.Contains(Partical_3) Then
                    ParticalBinCol_3 = 40
                End If
                If flex.GetCellValue(41, 3).ToString.Contains(Partical_3) Then
                    ParticalBinCol_3 = 41
                End If
                If flex.GetCellValue(42, 3).ToString.Contains(Partical_3) Then
                    ParticalBinCol_3 = 42
                End If
            Catch ex As Exception

            End Try



            For ii As Int16 = 0 To lots - 1
                flex.ActiveSheetByName = Cover

                XWriter.WriteStartElement("Lot") 'Start "RawLot" Element +++++++++++++++++++++++++++++++++++++++++++++
                XWriter.WriteAttributeString("LotSize", flex.GetCellValue(15, 2).ToString) 'Attributes
                XWriter.WriteAttributeString("MfgDate", mydateString) 'Attributes
                If ii <= 4 Then
                    XWriter.WriteAttributeString("LotID", flex.GetCellValue((11 + ii), 4).ToString) 'Attributes

                Else
                    Try
                        XWriter.WriteAttributeString("LotID", flex.GetCellValue((11 + ii) - 5, 6).ToString) 'Attributes
                    Catch ex As Exception
                        XWriter.WriteAttributeString("LotID", flex.GetCellValue((11 + ii) - 5, 7).ToString) 'Attributes
