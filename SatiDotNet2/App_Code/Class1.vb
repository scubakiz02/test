    Function FindParticalsFromSpec(ParticalString As String) As Int64
        Try
            If ParticalString.Contains("@") Then
                ParticalString = Mid(ParticalString, 3)
                ParticalString = Mid(ParticalString, 1, ParticalString.IndexOf(" "))
                If IsNumeric(ParticalString) Then
                    FindParticalsFromSpec = ParticalString
                Else
                    FindParticalsFromSpec = 0
                End If
            Else
                FindParticalsFromSpec = 0
            End If
        Catch ex As Exception
            FindParticalsFromSpec = 0
        End Try

    End Function

    Function GetWorkWeek(TheYear As Int16, DayOfYear As Int16) As Int16

        Select Case TheYear
            Case 2023, 2034 'Sun
                DayOfYear = DayOfYear - 1

            Case 2024, 2029, 2035 'Mon
                DayOfYear = DayOfYear + 0

            Case 2019, 2030, 2036 'Tue
                DayOfYear = DayOfYear + 1

            Case 2020, 2025, 2031 'Wed
                DayOfYear = DayOfYear + 2

            Case 2026, 2032, 2037 'Thur
                DayOfYear = DayOfYear + 3

            Case 2021, 2027, 2038 'Fri
                DayOfYear = DayOfYear + 4

            Case 2022, 2028, 2033, 2039 'Sat
                DayOfYear = DayOfYear + 5

        End Select

        Return (DayOfYear \ 7) + 1

    End Function


