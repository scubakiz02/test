    Function IBMSquitParticalMarker(ByVal TheText As String) As String
        Try
            IBMSquitParticalMarker = "None"

            If TheText.Contains("34nm") Then
                IBMSquitParticalMarker = "LPD034"
            End If

            If TheText.Contains("0.037") Then
                IBMSquitParticalMarker = "LPD037"
            End If

            If TheText.Contains("0.050") Then '3590
                IBMSquitParticalMarker = "LPD050"
            End If

            If TheText.Contains("0.055") Then
                IBMSquitParticalMarker = "LPD055"
            End If

            If TheText.Contains("0.065") Then
                IBMSquitParticalMarker = "LPD065"
            End If

            If TheText.Contains("0.080") Then
                IBMSquitParticalMarker = "LPD080"
            End If

            If TheText.Contains("0.090") Then
                IBMSquitParticalMarker = "LPD090"
            End If

            If TheText.Contains("0.12") Then
                IBMSquitParticalMarker = "LPD120"
            End If


        Catch ex As Exception
            IBMSquitParticalMarker = "None"
        End Try



    End Function

    Function MakeIBMDataPack(ByVal flex As FlexCel.XlsAdapter.XlsFile, ByVal Seq As String, ByVal UseRFID As Boolean) As Boolean
        flex.ActiveSheetByName = "C of A"
        Dim Fab As String = GetCustomerID(flex.GetCellValue(11, 2).ToString)
        Dim PLANTLINE As String = ""

        Select Case Fab

            Case "IBM-Yorktown"
                PLANTLINE = "YKT"

            Case "IBM-Albany"
                PLANTLINE = "ALB"

        End Select

        Select Case GetDiameter(flex.GetCellValue(11, 2).ToString)
            Case "300"
                MakeIBMDataPack300mm(flex, Seq, UseRFID, PLANTLINE)
            Case "200"
                MakeIBMDataPack200mm(flex, Seq, PLANTLINE)
        End Select

    End Function

    Function Make_ISquit_Package_Name() As String

        'ISQUIT_PUREWAFER_YYYYMMDD_HHMMSS
        Dim Package As String = "ISQUIT_PUREWAFER_"
        Dim DT As New DateTime
        DT = DateAndTime.Now


        Package = Package & DT.ToString("yyyyMMdd_HHmmss")
        'Package = Package & DT.ToString("YYYY MM DD _ HH MM SS")
        Return Package


    End Function

