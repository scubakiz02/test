        'End If

        flex.ActiveSheetByName = CofASheetName

        flex.Save("\\PWI-40\Customerdata$\" & mainid & "\" & FileName & ".xls")

        '************************************************************************
        '************************************************************************
        'flex.Save("\\PWI-40\LabelArchive$\!TestFiles\" & FileName & "_D.xls")
        '************************************************************************
        '************************************************************************







    End Function

    Function MakeShipment(ByVal CartonString As String, ByVal SmallPrinter As String, ByVal BigPrinter As String, ByVal PaperPrinter As String) As String
        Dim CartonStringCopy As String
        Dim SQLString As String
        Dim MoreCartons As Boolean
        Dim SQLStringCount As Int16
        Dim SnipCarton As String
        Dim Carton_Int As Integer
        Dim i As Integer
        Dim ShipmentQty As Integer
        Dim MainID As String
        Dim CLTemplate As String
        Dim DR_Spec As Data.DataRow
        Dim DR_PO As Data.DataRow
        Dim ShipmentNumber As String
        Dim Path As String
        Dim PreFix As String
        Dim FileName As String
        Dim Flex As New FlexCel.XlsAdapter.XlsFile
        Dim dtd As Date

        CartonStringCopy = CartonString

        'Make sure all the cartons are the same ID, Spec, PO
        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()
        'SELECT dbo.T_FGI_Cartons.CartonNumber, dbo.LabelsMade.Lot, dbo.LabelsMade.RecordNumber, dbo.LabelsMade.SO_Key, dbo.LabelsMade.Wafers, dbo.T_FGI_Boxes.BoxInvNumber, dbo.T_FGI_Boxes.InstanceKey FROM dbo.LabelsMade INNER JOIN dbo.T_FGI_Boxes ON dbo.LabelsMade.LabelRecordNumber = dbo.T_FGI_Boxes.LabelsMadeKey INNER JOIN dbo.T_FGI_Cartons ON dbo.T_FGI_Boxes.CartonNumber = dbo.T_FGI_Cartons.CartonNumber WHERE (dbo.T_FGI_Cartons.CartonNumber = 6) OR (dbo.T_FGI_Cartons.CartonNumber = 10)

        Dim DA_LabelsSpec As New Data.SqlClient.SqlDataAdapter
        Dim DS_LabelsSpec As New Data.DataSet
        Dim DR_LabelsSpec1 As Data.DataRow
        Dim DR_LabelsSpec2 As Data.DataRow

        Dim LabelsSpecSelectCmd As New System.Data.SqlClient.SqlCommand
        SQLString = "SELECT dbo.T_FGI_Cartons.CartonNumber, dbo.LabelsMade.Lot, dbo.LabelsMade.RecordNumber, dbo.LabelsMade.SO_Key, dbo.LabelsMade.Wafers, dbo.T_FGI_Boxes.BoxInvNumber, dbo.T_FGI_Boxes.InstanceKey FROM dbo.LabelsMade INNER JOIN dbo.T_FGI_Boxes ON dbo.LabelsMade.LabelRecordNumber = dbo.T_FGI_Boxes.LabelsMadeKey INNER JOIN dbo.T_FGI_Cartons ON dbo.T_FGI_Boxes.CartonNumber = dbo.T_FGI_Cartons.CartonNumber WHERE (dbo.T_FGI_Cartons.CartonNumber = "

        MoreCartons = True
        Do Until MoreCartons = False 'Build Where
            SQLStringCount = SQLStringCount + 1
            SnipCarton = Left(CartonString, CartonString.IndexOf(Chr(13)))
            If SnipCarton.Contains("CB") Then
                SnipCarton = Mid(SnipCarton, 3)
                Carton_Int = SnipCarton

                If SQLStringCount = 1 Then
                    SQLString = SQLString & Carton_Int.ToString
                Else
                    SQLString = SQLString & ") OR (dbo.T_FGI_Cartons.CartonNumber = " & Carton_Int.ToString
                End If

                CartonString = Mid(CartonString, CartonString.IndexOf(Chr(13)) + 3)

                If Not CartonString.Contains(Chr(13)) Then
                    SQLString = SQLString & ")"
                    With LabelsSpecSelectCmd
                        .CommandText = SQLString
                        .Connection = Connection
                    End With
                    DA_LabelsSpec.SelectCommand = LabelsSpecSelectCmd
                    DA_LabelsSpec.Fill(DS_LabelsSpec)
                    MoreCartons = False
                    Exit Do
                End If
            Else
                MakeShipment = "Error, Entered NonCarton"
                Exit Function
            End If
        Loop
        DR_LabelsSpec1 = DS_LabelsSpec.Tables(0).Rows(0)
        DR_LabelsSpec2 = DS_LabelsSpec.Tables(0).Rows(0)
        If SQLStringCount >= 2 Then
            'test
            For i = 0 To SQLStringCount - 2
                DR_LabelsSpec1 = DS_LabelsSpec.Tables(0).Rows(i)
                DR_LabelsSpec2 = DS_LabelsSpec.Tables(0).Rows(i + 1)

                'Check ID
                If Not DR_LabelsSpec1("Lot").ToString = DR_LabelsSpec2("Lot").ToString Then
                    MakeShipment = "Error, Mixed Lot's"
                    Exit Function
                End If

                'Check Spec
                If Not DR_LabelsSpec1("RecordNumber").ToString = DR_LabelsSpec2("RecordNumber").ToString Then
                    MakeShipment = "Error, Mixed Spec Number's"
                    Exit Function
                End If

                'Check PO
                If Find_If_PO_On_Label(Left(DR_LabelsSpec1("Lot").ToString, DR_LabelsSpec1("Lot").ToString.IndexOf("-"))) = True Then
                    If Not DR_LabelsSpec1("SO_Key").ToString = DR_LabelsSpec2("SO_Key").ToString Then
                        MakeShipment = "Error, Mixed SO Key's"
                        Exit Function
                    End If
                End If

                'Add Qty
                ShipmentQty = ShipmentQty + DR_LabelsSpec1("Wafers")
            Next
            ShipmentQty = ShipmentQty + DR_LabelsSpec2("Wafers")

        Else
            DR_LabelsSpec1 = DS_LabelsSpec.Tables(0).Rows(0)
            ShipmentQty = DR_LabelsSpec1("Wafers")
        End If

        MainID = Left(DR_LabelsSpec1("Lot").ToString, DR_LabelsSpec1("Lot").ToString.IndexOf("-"))

        CLTemplate = GetLabelTemplateForID(MainID, "CL", "Shipping WIP")

        DR_Spec = GetSpec(DR_LabelsSpec1("RecordNumber").ToString)

        If Find_If_PO_On_Label(MainID) = True Then
