    Function RecordLabelsMadeTable(ByVal Lot As String, ByVal WaferQty As Integer, ByVal Count As Integer, ByVal Spec_Record As Integer, ByVal SO_Record As Integer, ByVal RFID As String, ByVal SatiUser As String, ByVal LBN As Integer) As String

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()
        Dim DA_LabelRecord As New Data.SqlClient.SqlDataAdapter
        Dim DS_LabelRecord As New Data.DataSet
        Dim DR_LabelRecord As Data.DataRow

        Dim LabelRecordSelectCmd As New System.Data.SqlClient.SqlCommand
        With LabelRecordSelectCmd
            .CommandText = "Select LabelRecordNumber, Lot, LabelType, Wafers, Total_Qty, RecordNumber, SO_Key, Operator, EventTime, RFID, LotBoxNumber FROM dbo.LabelsMade WHERE (Lot = '0000-00000-0000')"
            .Connection = Connection
        End With
        DA_LabelRecord.SelectCommand = LabelRecordSelectCmd

        Dim LabelRecordInsertCmd As New System.Data.SqlClient.SqlCommand
        With LabelRecordInsertCmd
            .CommandText = "INSERT INTO [dbo].[LabelsMade] ([Lot], [LabelType], [Wafers], [Total_Qty], [RecordNumber], [SO_Key], [Operator], [EventTime], [RFID], [LotBoxNumber]) VALUES (@Lot, @LabelType, @Wafers, @Total_Qty, @RecordNumber, @SO_Key, @Operator, @EventTime, @RFID, @LotBoxNumber); SELECT LabelRecordNumber, Lot, LabelType, Wafers, Total_Qty, RecordNumber, SO_Key, Operator, EventTime, RFID, LotBoxNumber FROM dbo.LabelsMade WHERE (LabelRecordNumber = SCOPE_IDENTITY())"
            .Connection = Connection
            .Parameters.AddRange(New System.Data.SqlClient.SqlParameter() {New System.Data.SqlClient.SqlParameter("@Lot", System.Data.SqlDbType.NVarChar, 0, "Lot"), New System.Data.SqlClient.SqlParameter("@LabelType", System.Data.SqlDbType.NVarChar, 0, "LabelType"), New System.Data.SqlClient.SqlParameter("@Wafers", System.Data.SqlDbType.Int, 0, "Wafers"), New System.Data.SqlClient.SqlParameter("@Total_Qty", System.Data.SqlDbType.Int, 0, "Total_Qty"), New System.Data.SqlClient.SqlParameter("@RecordNumber", System.Data.SqlDbType.Int, 0, "RecordNumber"), New System.Data.SqlClient.SqlParameter("@SO_Key", System.Data.SqlDbType.Int, 0, "SO_Key"), New System.Data.SqlClient.SqlParameter("@Operator", System.Data.SqlDbType.NVarChar, 0, "Operator"), New System.Data.SqlClient.SqlParameter("@EventTime", System.Data.SqlDbType.SmallDateTime, 0, "EventTime"), New System.Data.SqlClient.SqlParameter("@RFID", System.Data.SqlDbType.NVarChar, 0, "RFID"), New System.Data.SqlClient.SqlParameter("@LotBoxNumber", System.Data.SqlDbType.Int, 0, "LotBoxNumber")})
        End With
        DA_LabelRecord.InsertCommand = LabelRecordInsertCmd

        DA_LabelRecord.TableMappings.AddRange(New System.Data.Common.DataTableMapping() {New System.Data.Common.DataTableMapping("Table", "LabelsMade", New System.Data.Common.DataColumnMapping() {New System.Data.Common.DataColumnMapping("LabelRecordNumber", "LabelRecordNumber"), New System.Data.Common.DataColumnMapping("Lot", "Lot"), New System.Data.Common.DataColumnMapping("LabelType", "LabelType"), New System.Data.Common.DataColumnMapping("Wafers", "Wafers"), New System.Data.Common.DataColumnMapping("Total_Qty", "Total_Qty"), New System.Data.Common.DataColumnMapping("RecordNumber", "RecordNumber"), New System.Data.Common.DataColumnMapping("SO_Key", "SO_Key"), New System.Data.Common.DataColumnMapping("Operator", "Operator"), New System.Data.Common.DataColumnMapping("EventTime", "EventTime"), New System.Data.Common.DataColumnMapping("RFID", "RFID"), New System.Data.Common.DataColumnMapping("LotBoxNumber", "LotBoxNumber")})})
        DA_LabelRecord.Fill(DS_LabelRecord) ' fill the ds with a blank query so the table is set for a insert

        DR_LabelRecord = DS_LabelRecord.Tables("LabelsMade").NewRow

        DR_LabelRecord("Lot") = Lot
        DR_LabelRecord("LabelType") = "WB"
        DR_LabelRecord("Wafers") = WaferQty
        DR_LabelRecord("Total_Qty") = Count
        DR_LabelRecord("RecordNumber") = Spec_Record
        DR_LabelRecord("SO_Key") = SO_Record
        DR_LabelRecord("Operator") = SatiUser
        DR_LabelRecord("EventTime") = DateTime.Now.ToShortDateString
        DR_LabelRecord("RFID") = RFID
        DR_LabelRecord("LotBoxNumber") = LBN

        DS_LabelRecord.Tables("LabelsMade").Rows.Add(DR_LabelRecord)
        DA_LabelRecord.Update(DS_LabelRecord, "LabelsMade")

        RecordLabelsMadeTable = DR_LabelRecord("LabelRecordNumber")

        Connection.Close()

    End Function

    Function GetLabel_LBN_NextNumber(ByVal Lot As String, ByVal Customer As String, ByVal ID As String) As Integer

        'SELECT Lot, MAX(LotBoxNumber) AS LBN FROM dbo.LabelsMade GROUP BY Lot HAVING (Lot = N'3117-4989P-R287')
        Dim ds As New Data.DataSet
        Dim DR As Data.DataRow

        If Customer = "GLOBALFOUNDRIES" Then
            ds = GetMyDataSet("SELECT MAX(LotBoxNumber) AS LBN FROM dbo.LabelsMade WHERE (Lot LIKE N'" & ID & "-%')")
        Else
            ds = GetMyDataSet("SELECT Lot, MAX(LotBoxNumber) AS LBN FROM dbo.LabelsMade GROUP BY Lot HAVING (Lot = N'" & Lot & "')")
