    Function CheckSeqDupe(ByVal BoxType As String, ByVal Box As String, Whitelist As Boolean) As String
        BoxType = UCase(BoxType)
        Dim MyInfo As String = ""
        Dim TheINumber As String = 0
        Dim DS As New Data.DataSet
        Dim DR As Data.DataRow
        Dim RC As Int16
        Dim DR_Look As Data.DataRow


        Select Case BoxType
            Case Is = "WB"
                'find the Instance
            Case Is = "CB"
                'find the Instance
            Case Is = "I"
                TheINumber = Box
        End Select

        Try
            DS = GetInstanceSeqRecords(TheINumber)
        Catch ex As Exception
            CheckSeqDupe = "Error, Getting Instance"
            Exit Function
        End Try

        RC = DS.Tables(0).Rows.Count

        ' Dim NeedChr("MM", "SE", "WA", "KO", "SJ", "JK", "TM", "MX", "KO", "SL", "WF", "MV", "ES") As String




        For i As Int16 = 0 To RC - 1
            DR = DS.Tables(0).Rows(i)
            For Look As Int16 = 0 To RC - 1
                If Not Look = i Then
                    DR_Look = DS.Tables(0).Rows(Look)
                    If Not IsNumeric(DR_Look("Seq")) Then 'Check and make sure that the Chr 6,7,8 is an Number and not have Alfa
                        MyInfo = MyInfo & "Not Numeric Seq " & DR("Seq").ToString & ", " & Chr(13)

                    End If
                    If DR_Look("Seq").ToString = DR("Seq").ToString Then
                        MyInfo = MyInfo & "Seq Dupe Slot " & DR("Seq").ToString & " : " & DR_Look("Seq").ToString & ", " & Chr(13)
                    End If
                End If
            Next

            'Look For White List
            If Whitelist = True Then
                If CheckScribeFor6610Whitelist(DR("T7").ToString) = False Then
                    MyInfo = MyInfo & "Forbidden Scribe In Slot " & DR("Slot").ToString & ", "
                End If
            End If
        Next
        CheckSeqDupe = MyInfo
    End Function

    Function CheckScribeFor6610Whitelist(T7 As String) As Boolean
        CheckScribeFor6610Whitelist = False
        'Dim NeedChr("MM", "SE", "WA", "KO", "SJ", "JK", "TM", "MX", "KO", "SL", "WF", "MV", "ES") As String
        Dim NeedChr() As String = {"MM", "SE", "WA", "KO", "SJ", "JK", "TM", "MX", "KO", "SL", "WF", "MV", "ES"}
        For Each STR As String In NeedChr
            If Right(T7, 2).Contains(STR) Then
                Return True
            End If
        Next
    End Function

