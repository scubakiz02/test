    Function CofA_StripAndSave(ByVal mainid As String, ByVal flex As FlexCel.XlsAdapter.XlsFile, ByVal FileName As String, ByVal LPDSheet As Boolean, ByVal LPDNSheet As Boolean, ByVal SODSheet As Boolean, ByVal metals As Boolean, ByVal SlotBySlotSheetName As String, ByVal Swan As Boolean, Non300mm As Boolean) As Boolean

        Dim CofASheetName As String
        Dim ADE_S1_Gx As String = ""
        Dim S1 As Boolean
        Dim ADE_S2_Gx As String = ""
        Dim S2 As Boolean
        Dim LPD_Gx As String = ""
        Dim LPD As Boolean
        Dim LPDN_Gx As String = ""
        Dim SOD_Gx As String = ""
        Dim i As Int16 'looping
        Dim SheetSeq As Int16
        flex.ActiveSheetByName = "Cust Spec Data"
        'find CofA sheet
        CofASheetName = flex.GetCellValue(2, 51).ToString

        'Find S1
        For i = 0 To 3
            If flex.GetCellValue(2, 57 + i) = "" Then
                If Not i = 0 Then
                    ADE_S1_Gx = flex.GetCellValue(3, (57 + i) - 1).ToString
                    S1 = True
                    Exit For
                Else
                    S1 = False
                End If
            End If
            If i = 3 Then
                If S1 = False Then
                    If Not flex.GetCellValue(2, 57 + i) = "" Then
                        ADE_S1_Gx = flex.GetCellValue(3, 57 + i).ToString
                        S1 = True
                    End If

                End If
            End If
        Next

        'Find S2
        For i = 0 To 3

            If flex.GetCellValue(2, 61 + i) = "" Then
                If Not i = 0 Then
                    ADE_S2_Gx = flex.GetCellValue(3, (61 + i) - 1).ToString
                    S2 = True
                    Exit For
                Else
                    S2 = False
                End If
            End If
            If i = 3 Then
                If S2 = False Then
                    If Not flex.GetCellValue(2, 61 + i) = "" Then
                        ADE_S2_Gx = flex.GetCellValue(3, 61 + i).ToString
                        S2 = True
                    End If
                End If

            End If
        Next

        'Find LPDs

        For i = 0 To 3
            If flex.GetCellValue(2, 65 + i) = "" Then
                If Not i = 0 Then
                    If LPDSheet = True Then
                        LPD_Gx = flex.GetCellValue(3, (65 + i) - 1).ToString
                    End If
                    If LPDNSheet = True Then
                        LPDN_Gx = flex.GetCellValue(20, (65 + i) - 1).ToString
                    End If
                    If SODSheet = True Then
                        SOD_Gx = flex.GetCellValue(21, (65 + i) - 1).ToString
                    End If

                    LPD = True
                Else
                    LPD = False
                End If
            End If
            If i = 3 Then
                If LPD = False Then
                    If Not flex.GetCellValue(2, 65 + i) = "" Then
                        If LPDSheet = True Then
                            LPD_Gx = flex.GetCellValue(3, 65 + i).ToString
                        End If
                        If LPDNSheet = True Then
                            LPDN_Gx = flex.GetCellValue(20, 65 + i).ToString
                        End If
                        If SODSheet = True Then
                            SOD_Gx = flex.GetCellValue(21, 65 + i).ToString
                        End If
                        LPD = True
                    End If
                End If
            End If
        Next

        SheetSeq = 1


        flex.ActiveSheetByName = "Data Calculations"
        flex.RecalcAndVerify()
        'flex.ConvertFormulasToValues(False)


        flex.ActiveSheetByName = CofASheetName
        flex.Recalc()

        '************************************************************************
        '************************************************************************
        'flex.Save("\\PWI-40\LabelArchive$\!TestFiles\" & FileName & "_C.xls")
        '************************************************************************
        '************************************************************************




        flex.Save("\\PWI-40\LabelArchive$\CofA Files\" & FileName & ".xls")
        '***********************************************************
        '******** The Delete Try ***********************************
        '***********************************************************
        Dim SheetCount As Integer
        Dim RemoveSheet As String
        Dim loopcounter As Integer = 1

        SheetCount = flex.SheetCount
        flex.RemoveMacros()
        For i = 1 To SheetCount
            Try
                flex.ActiveSheet = loopcounter
                RemoveSheet = flex.SheetName


                If Swan = True Then
                    Select Case RemoveSheet
                        Case Is = "Analysis"
                            flex.RecalcAndVerify()
                            flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = "CofC"
                            flex.RecalcAndVerify()
                            flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1
                        Case Else
                            flex.DeleteSheet(1)

                    End Select
                Else



                    Select Case RemoveSheet

                        Case Is = CofASheetName
                            flex.RecalcAndVerify()
                            flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = ADE_S1_Gx
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = ADE_S2_Gx
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = LPD_Gx
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = LPDN_Gx
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = SOD_Gx
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = "PickTicket"
                            flex.RecalcAndVerify()
                            If Non300mm = True Then
                                flex.SheetVisible = Core.TXlsSheetVisible.Hidden
                            End If
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = "PackingSlipPart2"
                            flex.RecalcAndVerify()
                            flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = SlotBySlotSheetName
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            loopcounter = loopcounter + 1

                        Case Is = "Data Calculations"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            flex.SheetVisible = Core.TXlsSheetVisible.Hidden
                            loopcounter = loopcounter + 1

                        Case Is = "Cust Spec Data"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            flex.SheetVisible = Core.TXlsSheetVisible.Hidden
                            loopcounter = loopcounter + 1

                        Case Is = "Metals"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            If metals = True Then
                                If Non300mm = False Then
                                    loopcounter = loopcounter + 1
                                Else
                                    flex.DeleteSheet(1)
                                End If
                            Else
                                flex.DeleteSheet(1)
                            End If

                        Case Is = "Metal"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            If metals = True Then
                                If Non300mm = True Then
                                    loopcounter = loopcounter + 1
                                Else
                                    flex.DeleteSheet(1)
                                End If
                            Else
                                flex.DeleteSheet(1)
                            End If

                        Case Is = "AllData"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            flex.SheetVisible = Core.TXlsSheetVisible.Hidden
                            loopcounter = loopcounter + 1

                        Case Is = "Analysis"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            flex.SheetVisible = Core.TXlsSheetVisible.Hidden
                            loopcounter = loopcounter + 1

                        Case Is = "CofC"
                            flex.RecalcAndVerify()
                            'flex.ConvertFormulasToValues(True)
                            flex.SheetVisible = Core.TXlsSheetVisible.Hidden
                            loopcounter = loopcounter + 1

                        Case Else
                            flex.DeleteSheet(1)

                    End Select
                End If


            Catch ex As Exception
                'i = 0
                'SheetCount = flex.SheetCount
            End Try

        Next

        '**********************************************************************************
        '*******************************update*********************************************
        '**********************************************************************************
        'For i = 1 To flex.SheetCount
