                FlexNew.SetCellValue(I - 2, 2, PartName.ToString)
                FlexNew.SetCellValue(I - 2, 3, "PURE WAFER")
                FlexNew.SetCellValue(I - 2, 4, PartNumber.ToString)


                Try ' Add the RFID
                    If flex.GetCellValue(I, 24).ToString.Length = 8 And flex.GetCellValue(I, 25).ToString.Length = 8 Then
