    Function GetNumber(ByVal UpperCap As Integer, ByVal lowerCap As Integer, ByVal SoftMulti As Int16) As Double

        Dim RanNumber As New Random
        Dim Num As Integer
        Dim Num2 As Integer
        Dim Num3 As Integer
        Dim Num4 As Double

        Num = RanNumber.Next(lowerCap, UpperCap) 'range
        Num2 = RanNumber.Next(1, UpperCap / SoftMulti) 'softer
        Num3 = Num - Num2 'The range with softer

        If Num3 < lowerCap Then
            Num3 = lowerCap
        End If

        Num4 = Num3
        GetNumber = Num4 / 100

    End Function

    Function GetRandomNumber(ByVal UpperCap As Integer, ByVal lowerCap As Integer) As Double

        Dim RanNumber As New Random
        Dim Num As Integer
        Num = RanNumber.Next(lowerCap, UpperCap) 'range
        GetRandomNumber = Num

    End Function

