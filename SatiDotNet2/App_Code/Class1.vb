    Function Find_ID_Exclusive_Metals(TheID As String) As Boolean
        Dim DS As New Data.DataSet
        Dim DR As Data.DataRow

        DS = GetMyDataSet("SELECT MainID, ProLotMetal FROM dbo.MainID WHERE (MainID = N'" & TheID & "')")

        If Not DS.Tables(0).Rows.Count = 0 Then
            DR = DS.Tables(0).Rows(0)
            If DR("ProLotMetal") = True Then
