    Function RFID_WriteTable(Actions_Make_Look_Update As String, InstanceNumber As String, SP2 As String, SP2Station As String, RFID_String As String) As String

        ' Note: This function will be built for Uses with Sati.Net and SPxDataCollector software.

        'Actions
        ' - Make new record (.net)
        ' - Get Record Status Info (.net)
        ' - Look for Need to Write (DC)
        ' - Update Record (DC and .net?)
        ' - 

        'F7FRxxxxxxxx
        '1st = F
        '2nd = 7 for Fab 7
        '3rd = F for Mirial KT-3004 A4
        '4th = R for Purewafer
        '5-12 = Instance number, Padding 0's on left

        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()

        Dim DA As New Data.SqlClient.SqlDataAdapter
        Dim DS As New Data.DataSet
        Dim DR As Data.DataRow

        Dim MySelectCmd As New System.Data.SqlClient.SqlCommand
        With MySelectCmd
            .CommandText = "SELECT [Key], InstanceNumber, SP2, SP2Station, RFID_String, Info, RecordUpdateDateTime FROM T_RFID_WriteTable WHERE (InstanceNumber = " & InstanceNumber & ")"
            .Connection = Connection
        End With
        DA.SelectCommand = MySelectCmd

        Dim MyInsertCmd As New System.Data.SqlClient.SqlCommand
        With MyInsertCmd
            .CommandText = "INSERT INTO [T_RFID_WriteTable] ([InstanceNumber], [SP2], [SP2Station], [RFID_String], [Info], [RecordUpdateDateTime]) VALUES (@InstanceNumber, @SP2, @SP2Station, @RFID_String, @Info, @RecordUpdateDateTime); SELECT [Key], InstanceNumber, SP2, SP2Station, RFID_String, Info, RecordUpdateDateTime FROM T_RFID_WriteTable WHERE ([Key] = SCOPE_IDENTITY())"
            .Connection = Connection
            .Parameters.AddRange(New System.Data.SqlClient.SqlParameter() {New System.Data.SqlClient.SqlParameter("@InstanceNumber", System.Data.SqlDbType.Int, 0, "InstanceNumber"), New System.Data.SqlClient.SqlParameter("@SP2", System.Data.SqlDbType.NVarChar, 0, "SP2"), New System.Data.SqlClient.SqlParameter("@SP2Station", System.Data.SqlDbType.NVarChar, 0, "SP2Station"), New System.Data.SqlClient.SqlParameter("@RFID_String", System.Data.SqlDbType.NVarChar, 0, "RFID_String"), New System.Data.SqlClient.SqlParameter("@Info", System.Data.SqlDbType.NVarChar, 0, "Info"), New System.Data.SqlClient.SqlParameter("@RecordUpdateDateTime", System.Data.SqlDbType.SmallDateTime, 0, "RecordUpdateDateTime")})
        End With
        DA.InsertCommand = MyInsertCmd

        Dim MyUpdateCmd As New System.Data.SqlClient.SqlCommand
        With MyUpdateCmd
            .CommandText = "UPDATE [T_RFID_WriteTable] SET [InstanceNumber] = @InstanceNumber, [SP2] = @SP2, [SP2Station] = @SP2Station, [RFID_String] = @RFID_String, [Info] = @Info, [RecordUpdateDateTime] = @RecordUpdateDateTime WHERE (([Key] = @Original_Key) AND ([InstanceNumber] = @Original_InstanceNumber) AND ([SP2] = @Original_SP2) AND ([SP2Station] = @Original_SP2Station) AND ([RFID_String] = @Original_RFID_String) AND ([Info] = @Original_Info) AND ((@IsNull_RecordUpdateDateTime = 1 AND [RecordUpdateDateTime] IS NULL) OR ([RecordUpdateDateTime] = @Original_RecordUpdateDateTime))); SELECT [Key], InstanceNumber, SP2, SP2Station, RFID_String, Info, RecordUpdateDateTime FROM T_RFID_WriteTable WHERE ([Key] = @Key)"
            .Connection = Connection
            .Parameters.AddRange(New System.Data.SqlClient.SqlParameter() {New System.Data.SqlClient.SqlParameter("@InstanceNumber", System.Data.SqlDbType.Int, 0, "InstanceNumber"), New System.Data.SqlClient.SqlParameter("@SP2", System.Data.SqlDbType.NVarChar, 0, "SP2"), New System.Data.SqlClient.SqlParameter("@SP2Station", System.Data.SqlDbType.NVarChar, 0, "SP2Station"), New System.Data.SqlClient.SqlParameter("@RFID_String", System.Data.SqlDbType.NVarChar, 0, "RFID_String"), New System.Data.SqlClient.SqlParameter("@Info", System.Data.SqlDbType.NVarChar, 0, "Info"), New System.Data.SqlClient.SqlParameter("@RecordUpdateDateTime", System.Data.SqlDbType.SmallDateTime, 0, "RecordUpdateDateTime"), New System.Data.SqlClient.SqlParameter("@Original_Key", System.Data.SqlDbType.Int, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "Key", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@Original_InstanceNumber", System.Data.SqlDbType.Int, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "InstanceNumber", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@Original_SP2", System.Data.SqlDbType.NVarChar, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "SP2", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@Original_SP2Station", System.Data.SqlDbType.NVarChar, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "SP2Station", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@Original_RFID_String", System.Data.SqlDbType.NVarChar, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "RFID_String", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@Original_Info", System.Data.SqlDbType.NVarChar, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "Info", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@IsNull_RecordUpdateDateTime", System.Data.SqlDbType.Int, 0, System.Data.ParameterDirection.Input, CType(0, Byte), CType(0, Byte), "RecordUpdateDateTime", System.Data.DataRowVersion.Original, True, Nothing, "", "", ""), New System.Data.SqlClient.SqlParameter("@Original_RecordUpdateDateTime", System.Data.SqlDbType.SmallDateTime, 0, System.Data.ParameterDirection.Input, False, CType(0, Byte), CType(0, Byte), "RecordUpdateDateTime", System.Data.DataRowVersion.Original, Nothing), New System.Data.SqlClient.SqlParameter("@Key", System.Data.SqlDbType.Int, 4, "Key")})
        End With
        DA.UpdateCommand = MyUpdateCmd

        DA.TableMappings.AddRange(New System.Data.Common.DataTableMapping() {New System.Data.Common.DataTableMapping("Table", "T_RFID_WriteTable", New System.Data.Common.DataColumnMapping() {New System.Data.Common.DataColumnMapping("Key", "Key"), New System.Data.Common.DataColumnMapping("InstanceNumber", "InstanceNumber"), New System.Data.Common.DataColumnMapping("SP2", "SP2"), New System.Data.Common.DataColumnMapping("SP2Station", "SP2Station"), New System.Data.Common.DataColumnMapping("RFID_String", "RFID_String"), New System.Data.Common.DataColumnMapping("Info", "Info"), New System.Data.Common.DataColumnMapping("RecordUpdateDateTime", "RecordUpdateDateTime")})})
        DA.Fill(DS)

        Select Case Actions_Make_Look_Update
            Case "Make"

                DR = DS.Tables("T_RFID_WriteTable").NewRow 'InstanceNumber, SP2, SP2Station, RFID_String, Info
                DR("InstanceNumber") = InstanceNumber
                DR("SP2") = SP2
                DR("SP2Station") = SP2Station
                DR("RFID_String") = RFID_String
                DR("Info") = "New"

                DS.Tables("T_RFID_WriteTable").Rows.Add(DR)
                DA.Update(DS, "T_RFID_WriteTable")
                Connection.Close()
                Return "Data Record Made"

            Case "Look"
                Try
                    DR = DS.Tables(0).Rows(0)
                    Connection.Close()
                    Return DR("Info").ToString

                Catch ex As Exception
                    Connection.Close()
                    Return "No Record Found"

                End Try

            Case "Update"
                DR = DS.Tables(0).Rows(0)
                DR.AcceptChanges()
                DR.BeginEdit()
                DR("Info") = "Wrote Tag"
                DR("RecordUpdateDateTime") = DateTime.Now.ToShortDateString
                DR.EndEdit()
                DA.Update(DS, "T_RFID_WriteTable")

        End Select
        Connection.Close()



    End Function


    Function ExportMRReport(ByVal MySql As String) As String
        Dim DS As New Data.DataSet
        DS = GetMyDataSet(MySql)
        Dim DR As Data.DataRow
        Dim Flex As New FlexCel.XlsAdapter.XlsFile(True)
        Dim Path As String = ""
        Dim ReportName As String = ""
        Dim FILE_NAME As String = "\\PWI-40\TempImageWebFiles$\MRReport " & User.Identity.Name.ToString & ".csv"
        Path = "\\PWI-40\software$\LabelTemplates\Sati_MR_Report.xls"
        Flex.Open(Path)
        Flex.ActiveSheetByName = "Data"
        Dim Rows As Integer = DS.Tables(0).Rows.Count

        Using sw As StreamWriter = File.CreateText(FILE_NAME)
            sw.WriteLine("Department,Tool,MR_Key,IssueDate,CloseDate,MinutesDown,HoursDown,DaysDown,Status,ReportOK")

            For I As Integer = 0 To Rows - 1
                DR = DS.Tables(0).Rows(I)
                If DR("ReportOK") = True Then
                    Flex.SetCellValue(I + 3, 2, DR("Department"))
                    Flex.SetCellValue(I + 3, 3, DR("Tool"))
                    Flex.SetCellValue(I + 3, 4, DR("MR_Key"))
                    Flex.SetCellValue(I + 3, 5, DR("IssueDate"))
                    Flex.SetCellValue(I + 3, 6, DR("CloseDate"))
                    Flex.SetCellValue(I + 3, 7, DR("MinutesDown"))
                    Flex.SetCellValue(I + 3, 8, DR("HoursDown"))
                    Flex.SetCellValue(I + 3, 9, DR("DaysDown"))
                    Flex.SetCellValue(I + 3, 10, DR("Status"))
                    Flex.SetCellValue(I + 3, 11, DR("ReportOK"))

                    sw.Write(DR("Department") & ",")
                    sw.Write(DR("Tool") & ",")
                    sw.Write(DR("MR_Key") & ",")
                    sw.Write(DR("IssueDate") & ",")
                    sw.Write(DR("CloseDate") & ",")
                    sw.Write(DR("MinutesDown") & ",")
                    sw.Write(DR("HoursDown") & ",")
                    sw.Write(DR("DaysDown") & ",")
                    sw.Write(DR("Status") & ",")
                    sw.WriteLine(DR("ReportOK"))
                End If

            Next


            ReportName = "\\PWI-40\TempImageWebFiles$\MRReport " & User.Identity.Name.ToString & ".xls"
            Flex.Save(ReportName)
            sw.Close()
        End Using

    End Function


    Function FGI_RFID_Checked(ByVal carton As String) As Boolean
        Try
            Dim ds As Data.DataSet
            Dim SQLstring As String
            Dim DR As Data.DataRow

            SQLstring = "SELECT dbo.T_FGI_Boxes.CartonNumber, dbo.LabelsMade.RFIDChecked FROM dbo.T_FGI_Boxes INNER JOIN dbo.LabelsMade ON dbo.T_FGI_Boxes.LabelsMadeKey = dbo.LabelsMade.LabelRecordNumber WHERE (dbo.T_FGI_Boxes.CartonNumber = " & carton & ")"
            ds = GetMyDataSet(SQLstring)
            DR = ds.Tables(0).Rows(0)
            If DR("RFIDChecked") = 0 Then
                Return False
            Else
                Return True
            End If
        Catch ex As Exception
            Return False
        End Try


    End Function

