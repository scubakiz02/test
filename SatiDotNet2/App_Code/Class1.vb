    Sub UpdateSPxTool(ByVal Tool As String)

        Dim AutoDataConnection As New Data.SqlClient.SqlConnection
        AutoDataConnection.ConnectionString = ConfigurationManager.ConnectionStrings("AutoDataConnectionString").ConnectionString
        AutoDataConnection.Open()

        Select Case Tool

            Case "SP1"
                'Update SP1 Data
                Dim SP1DataCollector As New System.Data.SqlClient.SqlCommand
                With SP1DataCollector
                    .CommandText = "exsil_user.[SP1DataCollector_SP11Only]"
                    .CommandType = System.Data.CommandType.StoredProcedure
                    .Parameters.AddRange(New System.Data.SqlClient.SqlParameter() {New System.Data.SqlClient.SqlParameter("@RETURN_VALUE", System.Data.SqlDbType.Int, 4, System.Data.ParameterDirection.ReturnValue, False, CType(0, Byte), CType(0, Byte), "", System.Data.DataRowVersion.Current, Nothing)})
                    .Connection = AutoDataConnection
                End With
                SP1DataCollector.ExecuteNonQuery()
                AutoDataConnection.Close()

            Case "SP2"
                'Update SP12 Data
                Dim SP1DataCollector As New System.Data.SqlClient.SqlCommand
                With SP1DataCollector
                    .CommandText = "exsil_user.[SP1DataCollector_SP12Only]"
                    .CommandType = System.Data.CommandType.StoredProcedure
                    .Parameters.AddRange(New System.Data.SqlClient.SqlParameter() {New System.Data.SqlClient.SqlParameter("@RETURN_VALUE", System.Data.SqlDbType.Int, 4, System.Data.ParameterDirection.ReturnValue, False, CType(0, Byte), CType(0, Byte), "", System.Data.DataRowVersion.Current, Nothing)})
                    .Connection = AutoDataConnection
                End With
                SP1DataCollector.ExecuteNonQuery()
                AutoDataConnection.Close()

            Case "SP1-3"
                'Update SP12 Data
                Dim SP1DataCollector As New System.Data.SqlClient.SqlCommand
                With SP1DataCollector
                    .CommandText = "exsil_user.[SP1DataCollector_SP13Only]"
                    .CommandType = System.Data.CommandType.StoredProcedure
                    .Parameters.AddRange(New System.Data.SqlClient.SqlParameter() {New System.Data.SqlClient.SqlParameter("@RETURN_VALUE", System.Data.SqlDbType.Int, 4, System.Data.ParameterDirection.ReturnValue, False, CType(0, Byte), CType(0, Byte), "", System.Data.DataRowVersion.Current, Nothing)})
                    .Connection = AutoDataConnection
                End With
                SP1DataCollector.ExecuteNonQuery()
                AutoDataConnection.Close()
            Case "SP2-S0132"
                'Real Time Data No Need For Update

        End Select
    End Sub

    Function Check_For_T7_Requierments(ByVal ID As String, ByVal Instance As Integer) As String
        'Returns a "Yes" if the ID has a record but, passed a "0" for Instance number

        Dim DS As Data.DataSet
        Dim DR As Data.DataRow
        Dim Feedback As String

        DS = GetMyDataSet("SELECT ID, Chr1, Chr2, Chr3, Chr4, Chr5, Chr6, Chr7, Chr8, Chr9, Chr10, Needs_True__NotWanted_False, Note FROM dbo.T_T7_Requirements_Check WHERE (ID = N'" & ID & "')")
        If Not DS.Tables(0).Rows.Count = 0 Then
            If Not Instance = 0 Then
                For I As Int16 = 0 To DS.Tables(0).Rows.Count - 1
                    DR = DS.Tables(0).Rows(I)
                    Feedback = CheckScibes_FindChr(Instance, DR("Chr1"), DR("Chr2"), DR("Chr3"), DR("Chr4"), DR("Chr5"), DR("Chr6"), DR("Chr7"), DR("Chr8"), DR("Chr9"), DR("Chr10"), DR("Needs_True__NotWanted_False"))
                    If Not Feedback = "Good" Then
                        Return Feedback
                    Else
                        Return "Good"
                    End If
                Next
            Else
                Return "Yes"
            End If
        Else
            Return "Good"
        End If
    End Function

    Function CheckScibes_FindChr(ByVal InstanceID As String, ByVal Chr1 As String, ByVal Chr2 As String, ByVal Chr3 As String, ByVal Chr4 As String, ByVal Chr5 As String, ByVal Chr6 As String, ByVal Chr7 As String, ByVal Chr8 As String, ByVal Chr9 As String, ByVal Chr10 As String, ByVal Needs_True__NotWanted_False As Boolean) As String

        Dim Scribes As New Data.DataSet
        Dim Row As Data.DataRow
        Dim T7 As String
        Dim Score As Int16 = 0
        Dim MaxScore As Int16 = 0
        Dim Message As String = ""

        Scribes = GetScribes(InstanceID)


        'Find out how many "*" to set max score value.
        If Chr1 = "*" Then
            MaxScore = MaxScore + 1
        End If
        If Chr2 = "*" Then
            MaxScore = MaxScore + 1
        End If
        If Chr3 = "*" Then
            MaxScore = MaxScore + 1
