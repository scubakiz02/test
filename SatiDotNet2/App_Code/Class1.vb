                ds = GetMyDataSet("SELECT CloseDate FROM dbo.T_SMR_Tickets WHERE (SMR_Key = " & Ticket & ")") 'SELECT CloseDate FROM dbo.T_SMR_Tickets WHERE (SMR_Key = 53868)
