            End If
        Next


        '**********************



        'Diameter Check -*/-*/-*/-*/-*/-*/-*/-*/-*/-*/-*/
        '
        '   *00*      E  E      /  \      Y  Y   
        ' *000000*  E      E  /      \  <      >
        ' *000000*  E      E  \      /  <      >
        '   *00*      E  E      \  /      T  T   
        '
        '   @  @      *--*      Q  Q      *  *   
        ' @      @  *++++++*  Q      Q  *      *
        ' @      @  *======*  Q      Q  *      *
        '   @  @      *--*      Q  Q      *  *   
        '
        '   +  +      O  O      *  *      X  X   
        ' +      +  O      O  * 0  0 *  X      X
        ' +      +  O      O  * 0  0 *  X      X
        '   +  +      O  O      *  *      X  X   
        '
        '   %  %      *  *      .  .      *||*   
        ' %      %  *      *  .      .  ***||***
        ' %      %  *      *  .      .  ***||***
        '   %  %      *  *      .  .      *||*   
        '
        Dim Diameter_Plus_or_Minus As Double = 0.2
        If UCase(DR("CustomerID").ToString).Contains("INTEL") Then
            Select Case DR("MainID").ToString
                Case "3628", "0" 'China has a +/-0.5
