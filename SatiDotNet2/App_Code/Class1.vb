    Function Data_Removal_Algorithm(R As Double) As Double

        Dim P As Double = 9 ' Primary
        Dim Pm As Double = -2 ' Primary Mod
        Dim S As Double = 19 ' Second
        Dim Sm As Double = -4 ' Second Mod
        Dim G As Double = 30 ' Greatest
        Dim Gm As Double = 8 ' Greatest Mod
        Dim C As Int16 = 35 ' Chance for anything above Primary to shift to Primary 0-100% 
        Dim Roll As Int16 = GetRandomNumber(100, 0)
        Dim T As Int16 = 40 ' Top cap. Anything >T will be set in Primary Target


        Select Case R
            Case < 1
                Return P

            Case P To S
                Return R + Pm

            Case S To G
                Return R + Sm

            Case G To T
                Return R - G + Gm

            Case > T
                Select Case R
                    Case 30 To 40
                        Return R - 25
                    Case 40 To 50
                        Return R - 35
                    Case 50 To 60
                        Return R - 45
                    Case 60 To 70
                        Return R - 55
                    Case 70 To 80
                        Return R - 65
                    Case 80 To 90
                        Return R - 75
                    Case 90 To 100
                        Return R - 85
                    Case > 100
                        Return P
                End Select

            Case Else
                Return R

        End Select

    End Function

