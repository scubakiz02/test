    Function MakePackingSlip(ByVal CartonString As String, ByVal PackingSlip As String, ByVal PO As String,
    ByVal ShipQty As String, ByVal BoxQty As String, ByVal FreightAcct As String, ByVal Carrier As String,
    ByVal FreightType As String, ByVal ShippingAddress As Data.DataSet, ByVal BillingAddress As Data.DataSet, ByVal CrossFabShipOrgID As String) As String
        Dim CartonStringCopy As String
        Dim SQLString As String
        Dim SQLNumberString As String
        Dim MoreCartons As Boolean
        Dim SQLStringCount As Int16
        Dim SnipCarton As String
        Dim Carton_Int As Integer
        Dim i As Integer
        Dim ShipmentQty As Integer
        Dim MainID As String
        Dim DR_Spec As Data.DataRow
        Dim DR_PO As Data.DataRow
        Dim Path As String
        Dim FileName As String
        Dim Flex As New FlexCel.XlsAdapter.XlsFile(True)
        CartonStringCopy = CartonString

        'Make sure all the cartons are the same ID, Spec, PO
        Dim Connection As New Data.SqlClient.SqlConnection
        Connection.ConnectionString = ConfigurationManager.ConnectionStrings("ALTSConnectionString").ConnectionString
        Connection.Open()

        Dim DA_LabelsSpec As New Data.SqlClient.SqlDataAdapter
        Dim DA_Lots As New Data.SqlClient.SqlDataAdapter
        Dim DS_LabelsSpec As New Data.DataSet
        Dim DR_LabelsSpec1 As Data.DataRow
        Dim DR_LabelsSpec2 As Data.DataRow
        Dim DS_Lots As New Data.DataSet
        Dim DR_Lots As Data.DataRow

        Dim LabelsSpecSelectCmd As New System.Data.SqlClient.SqlCommand
        Dim LotsSelectCmd As New System.Data.SqlClient.SqlCommand

        SQLString = "SELECT dbo.T_FGI_Boxes.CartonNumber, dbo.LabelsMade.Lot, dbo.LabelsMade.RecordNumber, dbo.LabelsMade.SO_Key, dbo.LabelsMade.Wafers, dbo.T_FGI_Boxes.BoxInvNumber, dbo.T_FGI_Boxes.InstanceKey FROM dbo.LabelsMade INNER JOIN dbo.T_FGI_Boxes ON dbo.LabelsMade.LabelRecordNumber = dbo.T_FGI_Boxes.LabelsMadeKey WHERE (dbo.T_FGI_Boxes.CartonNumber = "
        SQLNumberString = "SELECT dbo.LabelsMade.Lot, SUM(dbo.LabelsMade.Wafers) AS Qty FROM dbo.LabelsMade INNER JOIN dbo.T_FGI_Boxes ON dbo.LabelsMade.LabelRecordNumber = dbo.T_FGI_Boxes.LabelsMadeKey WHERE (dbo.T_FGI_Boxes.CartonNumber = "

        MoreCartons = True
        Do Until MoreCartons = False 'Build Where
            SQLStringCount = SQLStringCount + 1
            SnipCarton = Left(CartonString, CartonString.IndexOf(Chr(13)))
            If SnipCarton.Contains("CB") Then
                SnipCarton = Mid(SnipCarton, 3)
                Carton_Int = SnipCarton

                If SQLStringCount = 1 Then
                    SQLString = SQLString & Carton_Int.ToString
                    SQLNumberString = SQLNumberString & Carton_Int.ToString
                Else
                    SQLString = SQLString & ") OR (dbo.T_FGI_Boxes.CartonNumber = " & Carton_Int.ToString
                    SQLNumberString = SQLNumberString & ") OR (dbo.T_FGI_Boxes.CartonNumber  = " & Carton_Int.ToString
                End If

                CartonString = Mid(CartonString, CartonString.IndexOf(Chr(13)) + 2)

                If Not CartonString.Contains(Chr(13)) Then

                    SQLNumberString = SQLNumberString & ") GROUP BY dbo.LabelsMade.Lot"
                    With LotsSelectCmd
                        .CommandText = SQLNumberString
                        .Connection = Connection
                    End With
                    DA_Lots.SelectCommand = LotsSelectCmd
                    DA_Lots.Fill(DS_Lots)

                    SQLString = SQLString & ")"
                    With LabelsSpecSelectCmd
                        .CommandText = SQLString
                        .Connection = Connection
                    End With
                    DA_LabelsSpec.SelectCommand = LabelsSpecSelectCmd
                    DA_LabelsSpec.Fill(DS_LabelsSpec)
                    MoreCartons = False
                    Exit Do
                End If
            Else
                MakePackingSlip = "Error, Entered NonCarton"
                Exit Function
            End If
        Loop

        DR_LabelsSpec1 = DS_LabelsSpec.Tables(0).Rows(0)
        DR_LabelsSpec2 = DS_LabelsSpec.Tables(0).Rows(0)
        Dim ID1 As String
        Dim ID2 As String
        If SQLStringCount >= 2 Then
            'test
            For i = 0 To SQLStringCount - 2
                DR_LabelsSpec1 = DS_LabelsSpec.Tables(0).Rows(i)
                DR_LabelsSpec2 = DS_LabelsSpec.Tables(0).Rows(i + 1)
                ID1 = Mid(DR_LabelsSpec1("Lot").ToString, 1, DR_LabelsSpec1("Lot").ToString.IndexOf("-"))
                ID2 = Mid(DR_LabelsSpec2("Lot").ToString, 1, DR_LabelsSpec2("Lot").ToString.IndexOf("-"))
                'Check ID
                If Not ID1 = ID2 Then
                    MakePackingSlip = "Error, Mixed Lot ID's"
                    Exit Function
                End If

                'Check Spec
                If Not DR_LabelsSpec1("RecordNumber").ToString = DR_LabelsSpec2("RecordNumber").ToString Then
                    MakePackingSlip = "Error, Mixed Spec Number's"
                    Exit Function
                End If

                'Check PO
                If Find_If_PO_On_Label(Left(DR_LabelsSpec1("Lot").ToString, DR_LabelsSpec1("Lot").ToString.IndexOf("-"))) = True Then
                    If Not DR_LabelsSpec1("SO_Key").ToString = DR_LabelsSpec2("SO_Key").ToString Then
                        MakePackingSlip = "Error, Mixed SO Key's"
                        Exit Function
                    End If
                End If

                'Add Qty
                ShipmentQty = ShipmentQty + DR_LabelsSpec1("Wafers")
            Next
            ShipmentQty = ShipmentQty + DR_LabelsSpec2("Wafers")

        Else
            DR_LabelsSpec1 = DS_LabelsSpec.Tables(0).Rows(0)
            ShipmentQty = DR_LabelsSpec1("Wafers")
        End If

        If Not CrossFabShipOrgID = "" Then '****Cross Fab*********'****Cross Fab*********
            MainID = CrossFabShipOrgID
        Else
            MainID = Left(DR_LabelsSpec1("Lot").ToString, DR_LabelsSpec1("Lot").ToString.IndexOf("-"))
        End If


        DR_Spec = GetSpecForCofA(DR_LabelsSpec1("RecordNumber").ToString)

        If Find_If_PO_On_Label(MainID) = True Then
            DR_PO = GetPO_bySOKey(DR_LabelsSpec1("SO_Key"))
        Else
            DR_PO = GetIDCurrentPO(MainID)
        End If

        Dim PS_File_Name As String
        PS_File_Name = GetLabelTemplateForID(MainID, "PS", "Shipping WIP")


        'Path = "\\PWI-40\software$\LabelTemplates\Master_Packing_Slip_New.xls"
        Path = "\\PWI-40\software$\LabelTemplates\" & PS_File_Name & ".xls"

        FileName = "PS-" & MainID & "_" & PackingSlip & " " & Date.Now.ToFileTime
        Flex.Open(Path)
        Flex.Recalc(True)

        Flex.ActiveSheetByName = "Data"

        Flex.SetCellValue(2, 2, PackingSlip)
        Flex.SetCellValue(2, 3, DR_Spec("PART_NUMBER"))
        Flex.SetCellValue(2, 4, DR_PO("PO_Number"))
        Flex.SetCellValue(2, 5, FreightAcct)
        Flex.SetCellValue(2, 6, DateTime.Now.ToShortDateString)
        Flex.SetCellValue(2, 7, DR_Spec("SPEC_NUMBER"))
        Flex.SetCellValue(2, 8, DR_Spec("SPEC_REV_NUMBER"))
        Flex.SetCellValue(2, 9, Carrier)
        Flex.SetCellValue(2, 10, FreightType)
        Flex.SetCellValue(2, 11, DR_Spec("PackingSlip_Note"))

        'Dim BillingAddress As Data.DataSet
        Dim BillingDataRow As Data.DataRow
        'BillingAddress = GetAddress("Billing", MainID)
        BillingDataRow = BillingAddress.Tables(0).Rows(0)

        'Dim Shippingaddress As Data.DataSet
        Dim ShippingDataRow As Data.DataRow
        'Shippingaddress = GetAddress("Shipping", MainID)
        ShippingDataRow = ShippingAddress.Tables(0).Rows(0)

        Flex.SetCellValue(5, 9, BillingDataRow("Row1"))
        Flex.SetCellValue(6, 9, BillingDataRow("Row2"))
        Flex.SetCellValue(7, 9, BillingDataRow("Row3"))
        Flex.SetCellValue(8, 9, BillingDataRow("Row4"))
        Flex.SetCellValue(9, 9, BillingDataRow("Row5"))
        Flex.SetCellValue(10, 9, BillingDataRow("Row6"))

        Flex.SetCellValue(5, 10, ShippingDataRow("Row1"))
        Flex.SetCellValue(6, 10, ShippingDataRow("Row2"))
        Flex.SetCellValue(7, 10, ShippingDataRow("Row3"))
        Flex.SetCellValue(8, 10, ShippingDataRow("Row4"))
        Flex.SetCellValue(9, 10, ShippingDataRow("Row5"))
        Flex.SetCellValue(10, 10, ShippingDataRow("Row6"))

        'Lots
        Dim QtyOfLotNumebr As Int16
        Dim ilot As Int16
        Dim IntelLot As String
        Dim OrgLot As String

        QtyOfLotNumebr = DS_Lots.Tables(0).Rows.Count
        For ilot = 0 To QtyOfLotNumebr - 1
            DR_Lots = DS_Lots.Tables(0).Rows(ilot)

            If ShippingDataRow("Row1").ToString.Contains("intel") Then
                OrgLot = DR_Lots("Lot").ToString
                IntelLot = Mid(OrgLot, 1, OrgLot.LastIndexOf("-"))
                IntelLot = IntelLot.Replace("-", "")

                Flex.SetCellValue(4, ilot + 4, IntelLot)
            Else
                Flex.SetCellValue(ilot + 5, 2, DR_Lots("Lot"))
            End If

            Flex.SetCellValue(ilot + 5, 3, DR_Lots("Qty"))
        Next

        Flex.Recalc()

        Flex.ActiveSheetByName = "Packing Slip Copy"

        'Flex.Save("\\PWI-40\LabelArchive$\PickTickets\" & FileName & ".xls")
        Flex.Save("\\PWI-40\Customerdata$\" & MainID & "\" & FileName & ".xls")
        Connection.Close()
        MakePackingSlip = FileName

    End Function

    Function ShippmentFinalRecordEntry(ByVal CartonString As String, ByVal PickTicket As String) As String

        Dim SnipCarton As String
        Dim Carton_Int As String
        Dim MoreCartons As Boolean = True
        Dim Index As Int16 = 0

        'Check to see if shipment is a rerun. if so remove all the Pickticket number from records
        ShippingInvTable("Clean", "", "", "", PickTicket, "", "SATI")



        Do Until MoreCartons = False
            SnipCarton = Left(CartonString, CartonString.IndexOf(Chr(13)))
            If SnipCarton.Contains("C") Then
                If SnipCarton.Contains("CB") Then
                    Index = 3
                Else
                    Index = 2
                End If
                SnipCarton = Mid(SnipCarton, Index)
                Carton_Int = SnipCarton
                ShippingInvTable("AddPickTicket", Carton_Int, "", "", PickTicket, "", "SATI")
                CartonString = Mid(CartonString, CartonString.IndexOf(Chr(13)) + 2)

                If Not CartonString.Contains(Chr(13)) Then
                    MoreCartons = False
                    Exit Do
                End If

            Else
                ShippmentFinalRecordEntry = "Error, With Removing Inv"
                Exit Function
            End If
        Loop
        '1 Shipping_Log Table for input and get ShippingID, Function Shipping_LogTabl
        '2 ShippingUnit Table for input of ShippingID and Get PalletKey, Function Shipping_UnitTable
        '3 Pick_Shipping Table for Input of PalletKey, Function Pick_Shipping_UnitTable

        ShippmentFinalRecordEntry = "Cartons removed from Inv."
    End Function

