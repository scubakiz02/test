    Function GetMetalsProL(Carton As Boolean, instance As Boolean, Box As String) As Data.DataSet
        Dim DS As New Data.DataSet
        Dim DS_Metal As Data.DataSet
        Dim DR As Data.DataRow
        Dim Lotnumber As String

        If Carton = True Or instance = True Then

            If Carton = True Then
                DS = GetMyDataSet("SELECT dbo.ShippingInventory.Carton_Key, SUM(dbo.ShippingInventory.Total_Qty) AS Qty, dbo.LabelsMade.Lot FROM dbo.ShippingInventory INNER JOIN dbo.LabelsMade ON dbo.ShippingInventory.LotEntry = dbo.LabelsMade.LabelRecordNumber GROUP BY dbo.LabelsMade.Lot, dbo.ShippingInventory.Carton_Key HAVING (dbo.ShippingInventory.Carton_Key = " & Box & ")")
            End If

            If instance = True Then
                DS = GetMyDataSet("SELECT dbo.T_FGI_Boxes.InstanceKey, dbo.LabelsMade.Lot FROM dbo.LabelsMade INNER JOIN dbo.T_FGI_Boxes ON dbo.LabelsMade.LabelRecordNumber = dbo.T_FGI_Boxes.LabelsMadeKey WHERE (dbo.T_FGI_Boxes.InstanceKey = " & Box & ")")
            End If

            If DS.Tables(0).Rows.Count > 0 Then
                DR = DS.Tables(0).Rows(0)
                Lotnumber = DR("Lot")
                DS_Metal = GetMyDataSet("SELECT TOP (100) PERCENT [Date/Time], Source, [Test Type], Location, Idenyification, Notes, NotesExtra, Ca, Ma, Ni, Zn, Al, Fe, Cr, Cu, Na, K, Co, Mn, Mo, W, Ti, [Record Number] FROM dbo.[GFAAS Data] WHERE (Idenyification LIKE N'%" & Mid(Lotnumber, Lotnumber.IndexOf("-") + 1) & "') AND (Notes IS NULL) AND (LEFT(Source, 4) = 'ProL') AND ([Date/Time] > DATEADD(dd, - 180, { fn NOW() })) ORDER BY [Record Number] DESC")
                If DS_Metal.Tables(0).Rows.Count >= 2 Then
                    GetMetalsProL = DS_Metal
                    Exit Function
                End If
                Exit Function
            End If
        End If

        'SELECT TOP (100) PERCENT [Date/Time], Source, [Test Type], Location, Idenyification, Notes, NotesExtra, Ca, Ma, Ni, Zn, Al, Fe, Cr, Cu, Na, K, Co, Mn, Mo, W, Ti, [Record Number] FROM dbo.[GFAAS Data] WHERE (Idenyification LIKE N'%-4338-9250') AND (Notes IS NULL) AND (LEFT(Source, 4) = 'ProL') AND ([Date/Time] > DATEADD(dd, - 180, { fn NOW() })) ORDER BY [Record Number] DESC

        'GetMetalsProL = GetMyDataSet("SELECT TOP (100) PERCENT [Date/Time], Source, [Test Type], Location, Idenyification, Notes, NotesExtra, Ca, Ma, Ni, Zn, Al, Fe, Cr, Cu, Na, K, Co, Mn, Mo, W, Ti, [Record Number] FROM dbo.[GFAAS Data] WHERE (Idenyification LIKE N'%" & Mid(Lotnumber, Lotnumber.IndexOf("-") + 1) & "') AND (Notes IS NULL) AND (LEFT(Source, 4) = 'ProL') AND ([Date/Time] > DATEADD(dd, - 180, { fn NOW() })) ORDER BY [Record Number] DESC")

    End Function

