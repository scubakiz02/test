    Function FreeScaleFabFind(ByVal MainID As String) As String

        Dim DS As New Data.DataSet
        'SELECT MainID, CustomerID AS fab FROM dbo.MainID WHERE (MainID = N'2569')
        DS = GetMyDataSet("SELECT MainID, CustomerID AS fab FROM dbo.MainID WHERE (MainID = N'" & MainID & "')")

        Dim DR As Data.DataRow = DS.Tables(0).Rows(0)
        Dim Fab As String = DR("fab").ToString


        'FSL-ATMC
        'FSL-CHD-EPM
        'FSL-CHD-Fab
        'FSL-CHD-MRAM
        'FSL-OHT-Fab

        Select Case Fab

            Case "NXP-ATMC"
                FreeScaleFabFind = "ATMC"
                Return FreeScaleFabFind
            Case "NXP-CHD-EPM"
                FreeScaleFabFind = "CHD"
                Return FreeScaleFabFind
            Case "NXP-CHD-Fab"
                FreeScaleFabFind = "CHD"
                Return FreeScaleFabFind
            Case "NXP-CHD-MRAM"
                FreeScaleFabFind = "CHD"
                Return FreeScaleFabFind
            Case "NXP-OHT"
                FreeScaleFabFind = "OHT"
                Return FreeScaleFabFind
            Case "NXP-NY"
                FreeScaleFabFind = "NY"
                Return FreeScaleFabFind
        End Select

        'Return Fab


    End Function

    Function MakeGFDataPack(ByVal flex As FlexCel.XlsAdapter.XlsFile) As Boolean
        flex.ActiveSheetByName = "C of A"
        Dim Fab As String = GetCustomerID(flex.GetCellValue(11, 2).ToString)
        Dim PLANTLINE As String = ""

        Select Case Fab
            Case "ON-Semi-EFK"
                PLANTLINE = "EFK"
                Make_GF_300mm_XMLDataPack(flex, PLANTLINE)
            Case "Global-VT"
                PLANTLINE = "BTV"
                Make_GF_200mm_XM_XMLDataPack(flex, PLANTLINE)
        End Select

    End Function





