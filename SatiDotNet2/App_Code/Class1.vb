        If ds.Tables(0).Rows.Count = 0 Then
            GetLabel_LBN_NextNumber = 1
        Else
            DR = ds.Tables(0).Rows(0)
            GetLabel_LBN_NextNumber = DR("LBN") + 1
        End If


    End Function

