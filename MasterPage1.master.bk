<%@ Master Language="VB" CodeFile="MasterPage1.master.vb" Inherits="MasterPage1" %>
<%@ Register assembly="AjaxControlToolkit" namespace="AjaxControlToolkit" tagprefix="cc2" %>
<%-- <!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">--%>
<!DOCTYPE html>
<%-- <html xmlns="http://www.w3.org/1999/xhtml" > --%>
<html lang="en">

<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SATI.Net</title>
    <link href="SatiStyle.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .style1
        {
            width: 100%;
            
        }
    </style>
</head>
<body style="background-color: #000000"> 
    <div  >
        <form id="form1" runat="server">
            <br />
            <asp:ScriptManager ID="ScriptManager1" runat="server" 
                AsyncPostBackTimeout="600">
            </asp:ScriptManager>
               
            <asp:Panel ID="MasterPagePanel" runat="server" Width="1050px" HorizontalAlign="Center">
                 
                <asp:Panel  ID="MasterPagePanelTop" runat="server" Width="1024px" HorizontalAlign="Left" 
                    BackColor="#CCCCCC" >
                    <table class="style1">
                        <tr>
                            <td style="padding-left: 4px">
                                <asp:Label ID="Label1" runat="server" Font-Bold="True" Font-Size="XX-Large" 
                                    ForeColor="Blue" Text="SATI.Net">
                                </asp:Label>
                                <br />
                           
                                <asp:Menu ID="Menu1" runat="server" BackColor="#B5C7DE" 
                                    DataSourceID="SiteMapDataSource1" DynamicHorizontalOffset="2" 
                                    Font-Names="Verdana" Font-Size="0.8em" ForeColor="Black" 
                                    StaticSubMenuIndent="10px" Orientation="Horizontal">
                                    <StaticSelectedStyle BackColor="#507CD1" />
                                    <StaticMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
                                    <DynamicHoverStyle BackColor="#284E98" ForeColor="White" />
                                    <DynamicMenuStyle BackColor="#B5C7DE" />
                                    <DynamicItemTemplate>
                                        <%# Eval("Text") %>
                                    </DynamicItemTemplate>
                                    <DynamicSelectedStyle BackColor="#507CD1" />
                                    <DynamicMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
                                    <DataBindings>
                                        <asp:MenuItemBinding DataMember="SiteMapNode" Depth="2" EnabledField="Title" 
                                            NavigateUrlField="Url" SelectableField="Title" TextField="Title" />
                                    </DataBindings>
                                    <StaticHoverStyle BackColor="#284E98" ForeColor="White" />
                                </asp:Menu>
                           
                            
                            </td>
                            <td style="text-align: right; vertical-align: bottom; padding-right: 25px;">
                                <asp:LoginStatus ID="LoginStatus1" runat="server" LogoutPageUrl="~/Main1.aspx" />
                                <br />
                                <asp:LoginName ID="LoginName1" runat="server" Font-Bold="True" Font-Size="Large"  FormatString="Hello,  {0}" />
                            
                            </td>
                        </tr>
                    </table>              
                </asp:Panel>
                <cc2:RoundedCornersExtender ID= "RoundedCornersPanel5" runat ="server" TargetControlID="MasterPagePanelTop" Radius="10" Corners="Top"/>
            
                <asp:Panel ID="MasterPagePanelMidCenter" runat="server" HorizontalAlign="Center" Width="1050px" >
                    <asp:Panel ID="MasterPagePanelMain"  runat="server" Width="1024px" HorizontalAlign="Left" BackColor="White" >
                        <table class="style1">
                            <tr>
                                <td style="padding-left: 6px">
                                    <asp:contentplaceholder id="ContentPlaceHolder1" runat="server"> </asp:contentplaceholder>
                                </td>
                            </tr>
                         </table>                           
                     </asp:Panel>
                </asp:Panel>
           
                <asp:Panel ID="MasterPagePanelBottom" runat="server" Width="1024px" 
                    HorizontalAlign="Center" BackColor="#666666" ForeColor="#CCCCCC" 
                    BackImageUrl="#666666" >
                
                    <asp:HyperLink ID="HyperLink2" runat="server" 
                        NavigateUrl="~/MR/MRT.aspx" ForeColor="White">Maintenance Request</asp:HyperLink>
                    &nbsp;<asp:LinkButton ID="LinkButton1" runat="server" 
                        PostBackUrl="~/CheckSum.aspx" Visible="false">Look CheckSum</asp:LinkButton>
                    <br />
                    <table class="style1">
                        <tr>
                            <td style="text-align: left">
                                &nbsp;</td>
                            <td style="text-align: left">
                                &nbsp;</td>
                        </tr>
                    </table>
                    <asp:HyperLink ID="HyperLink4" runat="server" BackColor="Gray" 
                        BorderColor="#666666" BorderStyle="Outset" BorderWidth="2px" ForeColor="White" 
                        NavigateUrl="\\pwi-40\docshare\Controlled Forms" Width="65px">Forms</asp:HyperLink>
                    &nbsp;|&nbsp;
                
                    <asp:HyperLink ID="HyperLink7" runat="server" BackColor="Gray" 
                        ForeColor="White" BorderStyle="Outset" BorderWidth="2px" 
                        NavigateUrl="\\PWI-40\docshare\Controlled Procedures" 
                        BorderColor="#666666" Width="105px">Procedures</asp:HyperLink>&nbsp;|&nbsp;
                
                    <asp:HyperLink ID="HyperLink5" runat="server"  
                        NavigateUrl="\\PWI-40\docshare\Controlled Work Instructions" 
                        BackColor="Gray" BorderStyle="Outset" BorderWidth="2px" ForeColor="White" 
                        BorderColor="#666666" Width="154px">Work Instructions</asp:HyperLink>&nbsp;|&nbsp; 
                
                
                    <asp:HyperLink ID="HyperLink8" runat="server" BackColor="Gray" 
                        ForeColor="White" BorderStyle="Outset" BorderWidth="2px"  
                        NavigateUrl="\\PWI-40\docshare\Labels" BorderColor="#666666" Width="105px">Misc Labels</asp:HyperLink>&nbsp;|&nbsp;
                
                    <asp:HyperLink ID="HyperLink6" runat="server" 
                        NavigateUrl="\\PWI-40\docshare\Controlled Recipes" 
                        BackColor="Gray" ForeColor="White" BorderColor="#666666" 
                        BorderStyle="Outset" BorderWidth="2px" Width="65px">Recipes</asp:HyperLink>  &nbsp;|&nbsp;

                    <asp:HyperLink ID="HyperLink3" runat="server" 
                        NavigateUrl="\\PWI-40\docshare\Pro-Logs" 
                        BackColor="Gray" ForeColor="White" BorderColor="#666666" 
                        BorderStyle="Outset" BorderWidth="2px" Width="65px">Pro Logs</asp:HyperLink>  &nbsp;|&nbsp;
                     
                    <asp:HyperLink ID="HyperLink1" runat="server" 
                        NavigateUrl="~/TestArea/MakeSwanseaCofA.aspx" 
                        BackColor="Gray" ForeColor="White" BorderColor="#666666" 
                        BorderStyle="Outset" BorderWidth="2px" Width="75px" Visible="False">Swan CofA Testing</asp:HyperLink>  
                
                    <br />
                    <br />
                    <asp:HyperLink ID="HyperLink10" runat="server" 
                        NavigateUrl="http://pwi-40:82/" 
                        BackColor="Gray" ForeColor="White" BorderColor="#666666" 
                        BorderStyle="Outset" BorderWidth="2px" Width="65px">Sati.Pulse</asp:HyperLink>  &nbsp;|&nbsp;

                    <asp:HyperLink ID="HyperLink11" runat="server" 
                        NavigateUrl="http://pwi-40:83/" 
                        BackColor="Gray" ForeColor="White" BorderColor="#666666" 
                        BorderStyle="Outset" BorderWidth="2px">Pure Wafer Web</asp:HyperLink>  &nbsp;|&nbsp;

                    <asp:HyperLink ID="HyperLink12" runat="server" 
                        NavigateUrl="~/Reports/BiTest.aspx" 
                        BackColor="Gray" ForeColor="White" BorderColor="#666666" 
                        BorderStyle="Outset" BorderWidth="2px">Bi Test</asp:HyperLink>  

                    <asp:UpdatePanel ID="UpdatePanel1" runat="server">
                        <ContentTemplate>
                            <asp:CheckBox ID="CheckBoxViewTranslator" runat="server" AutoPostBack="True" 
                                Text="View Translator" />
                            <asp:HyperLink ID="HyperLink9" runat="server" NavigateUrl="~/Test.aspx" Visible ="false">T</asp:HyperLink>
                        <br />

                        <br />
                            <asp:Panel ID="PanelTranslator" runat="server" HorizontalAlign="Center" 
                                Width="454px" BorderStyle="Solid" Visible="False" BackColor="#666666">
                                <asp:Panel ID="PanelTranslatorinside" runat="server" HorizontalAlign="Left" Width="426px">
                                    <table class="style1">
                                        <tr>
                                            <td>
                                                Translator</td>
                                            <td style="text-align: right">
                                                <asp:Button ID="ButtonCloseWindow" runat="server" Font-Size="Smaller" 
                                                    Text="Close" />
                                            </td>
                                        </tr>
                                    </table>
                                    <br />
                                    <br />
                                    WB
                                    <asp:TextBox ID="TextBoxWB_to_In" runat="server" Width="102px"></asp:TextBox>
                                    &nbsp;to Instance&nbsp;<asp:Button ID="ButtonFindInstance" runat="server" Text="Find" />
                                    &nbsp;<asp:Label ID="LabelIntance" runat="server" Font-Size="Larger" 
                                        ForeColor="Black"></asp:Label>
                                    <br />
                                    CB&nbsp;
                                    <asp:TextBox ID="TextBoxCB_to_WB" runat="server" Width="103px"></asp:TextBox>
                                    &nbsp;to WB&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                    <asp:Button ID="ButtonFindWaferBox" runat="server" Text="Find" />
                                    &nbsp;<asp:Label ID="LabelWaferBox" runat="server" Font-Size="Larger" 
                                        ForeColor="Black"></asp:Label>
                                    &nbsp;<br />
                                    <br />
                                
                                </asp:Panel>
                            </asp:Panel>
                        
                            <cc2:AlwaysVisibleControlExtender 
                            id="Ex" 
                            TargetControlID="PanelTranslator" 
                            runat="server"  
                            VerticalSide="Middle"
                            HorizontalSide="Center"
                            />
                                                  
                        </ContentTemplate>
                    </asp:UpdatePanel>                
                
                    <br /> 
                </asp:Panel>
                <cc2:RoundedCornersExtender ID= "RoundedCornersExtender1" runat ="server" TargetControlID="MasterPagePanelBottom" Radius="10" Corners="Bottom"/>           
                </asp:Panel>        
                <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" />           
              
        </form>
    </div>  
</body>
</html>
